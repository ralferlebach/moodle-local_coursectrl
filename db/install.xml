<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/coursectrl/db" VERSION="20260408"
    COMMENT="XMLDB schema for local_coursectrl (Course Control Hub)"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>

    <!-- ============================================================
         local_coursectrl_batch
         Head record of every bulk action execution.
         ============================================================ -->
    <TABLE NAME="local_coursectrl_batch" COMMENT="Head record of a bulk action batch">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="courseid"     TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="mdl_course.id"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="mdl_user.id of the actor"/>
        <FIELD NAME="action"       TYPE="char" LENGTH="64" NOTNULL="true"  COMMENT="e.g. shift_dates, set_visibility"/>
        <FIELD NAME="payloadjson"  TYPE="text"             NOTNULL="true"  COMMENT="Serialised action parameters"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="16" NOTNULL="true"  DEFAULT="pending"
               COMMENT="pending | previewed | executed | rolled_back | failed"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_batch_course"   UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_batch_user"     UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="idx_batch_status"   UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="idx_batch_created"  UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <!-- ============================================================
         local_coursectrl_batch_item
         Per-entity result record for every object touched in a batch.
         ============================================================ -->
    <TABLE NAME="local_coursectrl_batch_item" COMMENT="Per-entity result within a batch">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="batchid"     TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="FK local_coursectrl_batch.id"/>
        <FIELD NAME="entitytype"  TYPE="char" LENGTH="32" NOTNULL="true"  COMMENT="cm | section | course | label | text"/>
        <FIELD NAME="entityid"    TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="Context-specific ID"/>
        <FIELD NAME="component"   TYPE="char" LENGTH="64" NOTNULL="false"
               COMMENT="Moodle component for cm items, e.g. mod_assign"/>
        <FIELD NAME="status"      TYPE="char" LENGTH="16" NOTNULL="true"  DEFAULT="pending"
               COMMENT="pending | skipped | success | error"/>
        <FIELD NAME="previewjson" TYPE="text"             NOTNULL="false"
               COMMENT="Serialised preview_change DTO"/>
        <FIELD NAME="resultjson"  TYPE="text"             NOTNULL="false"
               COMMENT="Serialised execution_result DTO"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_batch" TYPE="foreign" FIELDS="batchid"
             REFTABLE="local_coursectrl_batch" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_bitem_batch"   UNIQUE="false" FIELDS="batchid"/>
        <INDEX NAME="idx_bitem_entity"  UNIQUE="false" FIELDS="entitytype, entityid"/>
      </INDEXES>
    </TABLE>

    <!-- ============================================================
         local_coursectrl_snapshot
         Pre-action state snapshot used as the rollback basis.
         ============================================================ -->
    <TABLE NAME="local_coursectrl_snapshot" COMMENT="Pre-action state snapshot for rollback">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="batchid"     TYPE="int"  LENGTH="10" NOTNULL="true"  COMMENT="FK local_coursectrl_batch.id"/>
        <FIELD NAME="entitytype"  TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="entityid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="component"   TYPE="char" LENGTH="64" NOTNULL="false"
               COMMENT="Moodle component, nullable for non-cm entities"/>
        <FIELD NAME="statejson"   TYPE="text"             NOTNULL="true"  COMMENT="Full serialised entity state"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"  TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_batch" TYPE="foreign" FIELDS="batchid"
             REFTABLE="local_coursectrl_batch" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_snap_batch"  UNIQUE="false" FIELDS="batchid"/>
        <INDEX NAME="idx_snap_entity" UNIQUE="false" FIELDS="entitytype, entityid"/>
      </INDEXES>
    </TABLE>

    <!-- ============================================================
         local_coursectrl_text_hit
         Detected date/time references inside free-text fields.
         ============================================================ -->
    <TABLE NAME="local_coursectrl_text_hit" COMMENT="Detected date/time references in free-text fields">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="courseid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="entitytype"      TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="entityid"        TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fieldname"       TYPE="char" LENGTH="64" NOTNULL="true"
               COMMENT="DB field name where the hit was found"/>
        <FIELD NAME="matchedtext"     TYPE="text"             NOTNULL="true"
               COMMENT="Raw string as found in the text"/>
        <FIELD NAME="normalizedvalue" TYPE="char" LENGTH="32" NOTNULL="false"
               COMMENT="ISO 8601 date or datetime if parseable"/>
        <FIELD NAME="confidence"      TYPE="char" LENGTH="16" NOTNULL="true"
               COMMENT="safe | ambiguous | informational"/>
        <FIELD NAME="contextjson"     TYPE="text"             NOTNULL="false"
               COMMENT="Surrounding text excerpt and offset information"/>
        <FIELD NAME="timecreated"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_hit_course"     UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_hit_entity"     UNIQUE="false" FIELDS="entitytype, entityid"/>
        <INDEX NAME="idx_hit_confidence" UNIQUE="false" FIELDS="confidence"/>
      </INDEXES>
    </TABLE>

    <!-- ============================================================
         local_coursectrl_risk
         Risk findings: conflicts, dead-ends, reachability issues.
         ============================================================ -->
    <TABLE NAME="local_coursectrl_risk" COMMENT="Risk findings from consistency and dead-end analysis">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="risktype"    TYPE="char" LENGTH="64" NOTNULL="true"
               COMMENT="dead_end | circular_lock | unresolvable_condition | temporal_conflict | missing_next_step"/>
        <FIELD NAME="severity"    TYPE="char" LENGTH="16" NOTNULL="true"
               COMMENT="critical | warning | info"/>
        <FIELD NAME="entitytype"  TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="entityid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="detailsjson" TYPE="text"             NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_risk_course"   UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_risk_type"     UNIQUE="false" FIELDS="risktype"/>
        <INDEX NAME="idx_risk_severity" UNIQUE="false" FIELDS="severity"/>
        <INDEX NAME="idx_risk_entity"   UNIQUE="false" FIELDS="entitytype, entityid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>

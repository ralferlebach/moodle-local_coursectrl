{{!
    @template local_coursectrl/checks

    Unified checks page: Consistency, Risk Assessment, Simulation tabs.

    Context variables:
      courseid       int
      checksurl      string
      tab_consistency, tab_risks, tab_simulation  bool
      runurl         string

      consistency.items[{severity,icon,cmname,cmurl,modname,headline,
                         detail,hasdetail,consequence,hasconsequence,
                         action,hasaction,simurl}]

      risks.rows[{severity,icon,score,typelabel,cmname,cmurl,modname,
                  problem,hasproblem,action,hasaction,
                  related[{name,url,modname}],hasrelated,
                  cascade[{name,url,modname}],hascascade,
                  cascade_count,simurl}]

    Example:
    {"courseid":42,"tab_consistency":true,"checksurl":"...",
     "consistency":{"items":[],"hasitems":false} }
}}

<div data-region="local_coursectrl-checks" class="local_coursectrl_checks">

  {{! Tab navigation }}
  <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
      <a class="nav-link{{#tab_consistency}} active{{/tab_consistency}}"
         href="{{checksurl}}&amp;tab=consistency">
        {{#str}} tab_consistency, local_coursectrl {{/str}}
        {{#consistency}}{{#totalcount}}<span class="badge bg-secondary ms-1">{{totalcount}}</span>{{/totalcount}}{{/consistency}}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link{{#tab_risks}} active{{/tab_risks}}"
         href="{{checksurl}}&amp;tab=risks">
        {{#str}} tab_risks, local_coursectrl {{/str}}
        {{#risks}}{{#totalcount}}<span class="badge bg-secondary ms-1">{{totalcount}}</span>{{/totalcount}}{{/risks}}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link{{#tab_simulation}} active{{/tab_simulation}}"
         href="{{checksurl}}&amp;tab=simulation">
        {{#str}} tab_simulation, local_coursectrl {{/str}}
      </a>
    </li>
  </ul>

  {{! ═══ Consistency ══ }}
  {{#tab_consistency}}
  {{#consistency}}
  <div data-region="panel-consistency">
    {{#hasitems}}
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <div class="d-flex gap-2 flex-wrap">
        {{#errorcount}}<span class="badge cc-badge-danger py-2 px-3">❗ {{errorcount}} {{#str}} checks_badge_error, local_coursectrl {{/str}}</span>{{/errorcount}}
        {{#warningcount}}<span class="badge cc-badge-warning py-2 px-3">⚠️ {{warningcount}} {{#str}} checks_badge_warning, local_coursectrl {{/str}}</span>{{/warningcount}}
        {{#noticecount}}<span class="badge cc-badge-info py-2 px-3">ℹ️ {{noticecount}} {{#str}} checks_badge_notice, local_coursectrl {{/str}}</span>{{/noticecount}}
      </div>
      <a href="{{deepanalysisurl}}" class="btn btn-primary btn-sm">
        {{#str}} checks_run_deepanalysis, local_coursectrl {{/str}}
      </a>
    </div>
    {{/hasitems}}
    {{^hasitems}}
    <div class="alert alert-success"><i class="fa fa-check-circle me-1"></i>{{#str}} checks_consistency_ok, local_coursectrl {{/str}}</div>
    {{/hasitems}}
    {{#hasitems}}
    <div class="vstack gap-2">
      {{#items}}
      <div class="card border-{{severity}}">
        <div class="card-header py-2 d-flex align-items-center gap-2 bg-transparent">
          <span class="flex-shrink-0">{{icon}}</span>
          {{#modname}}{{#pix}}monologo, mod_{{modname}}, {{cmname}}{{/pix}}{{/modname}}
          <a href="{{cmurl}}" class="fw-semibold text-decoration-none" target="_blank" rel="noopener">{{cmname}}</a>
          <span class="ms-1">— {{headline}}</span>
        </div>
        {{#hasdetail}}
        <div class="card-body py-2">
          <p class="mb-1">{{detail}}</p>
          {{#hasconsequence}}
          <p class="mb-1 small text-body-secondary">
            <strong>{{#str}} consistency_label_consequence, local_coursectrl {{/str}}</strong> {{consequence}}
          </p>
          {{/hasconsequence}}
          {{#hasaction}}
          <p class="mb-0 text-success small"><i class="fa fa-wrench fa-fw me-1"></i>{{action}}</p>
          {{/hasaction}}
        </div>
        {{/hasdetail}}
      </div>
      {{/items}}
    </div>
    {{/hasitems}}
  </div>
  {{/consistency}}
  {{/tab_consistency}}

  {{! ═══ Risk Assessment ══ }}
  {{#tab_risks}}
  {{#risks}}
  <div data-region="panel-risks">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <div class="text-muted small">
        {{#haslastrun}}{{#str}} checks_last_run, local_coursectrl {{/str}}: {{lastrundate}}{{/haslastrun}}
      </div>
      <a href="{{runurl}}" class="btn btn-primary btn-sm">
        {{#str}} checks_run_deepanalysis, local_coursectrl {{/str}}
      </a>
    </div>
    {{#hasresults}}
    <div class="d-flex gap-2 mb-3 flex-wrap">
      {{#errorcount}}<span class="badge cc-badge-danger py-2 px-3">❗ {{errorcount}} {{#str}} checks_badge_error, local_coursectrl {{/str}}</span>{{/errorcount}}
      {{#warningcount}}<span class="badge cc-badge-warning py-2 px-3">⚠️ {{warningcount}} {{#str}} checks_badge_warning, local_coursectrl {{/str}}</span>{{/warningcount}}
      {{#noticecount}}<span class="badge cc-badge-info py-2 px-3">ℹ️ {{noticecount}} {{#str}} checks_badge_notice, local_coursectrl {{/str}}</span>{{/noticecount}}
    </div>
    {{/hasresults}}
    {{^hasresults}}
    {{#haslastrun}}
    <div class="alert alert-success"><i class="fa fa-check-circle me-1"></i>{{#str}} checks_risks_ok, local_coursectrl {{/str}}</div>
    {{/haslastrun}}
    {{^haslastrun}}
    <div class="alert alert-info"><i class="fa fa-info-circle me-1"></i>{{#str}} checks_not_run_yet, local_coursectrl {{/str}}</div>
    {{/haslastrun}}
    {{/hasresults}}
    {{#hasrows}}
    <div class="vstack gap-2">
      {{#rows}}
      <div class="card border-{{severity}}">
        <div class="card-header py-2 d-flex align-items-center gap-2 bg-transparent flex-wrap">
          <span class="flex-shrink-0">{{icon}}</span>
          {{#modname}}{{#pix}}monologo, mod_{{modname}}, {{cmname}}{{/pix}}{{/modname}}
          <a href="{{cmurl}}" class="fw-semibold text-decoration-none" target="_blank" rel="noopener">{{cmname}}</a>
          <span class="text-muted small ms-1">— {{typelabel}}</span>
          {{#hasgrademode}}<span class="badge bg-secondary ms-1 small">{{grademode_label}}</span>{{/hasgrademode}}
          <span class="badge bg-light border text-muted ms-auto small">{{#str}} checks_score, local_coursectrl {{/str}} {{score}}</span>
        </div>
        <div class="card-body py-2">
          {{#hasproblem}}<p class="mb-1">{{problem}}</p>{{/hasproblem}}
          {{#hasrelated}}
          <p class="mb-1 small text-muted">
            {{#str}} checks_related, local_coursectrl {{/str}}:
            {{#related}}{{#modname}}{{#pix}}monologo, mod_{{modname}}, {{name}}{{/pix}}{{/modname}}<a href="{{url}}" target="_blank" rel="noopener" class="me-2">{{name}}</a>{{/related}}
          </p>
          {{/hasrelated}}
          {{#hasaction}}<p class="mb-0 text-success small"><i class="fa fa-wrench fa-fw me-1"></i>{{action}}</p>{{/hasaction}}
          <div class="mt-2 d-flex flex-wrap gap-2">
            {{#has_fix}}
            <a href="{{fix_url}}" class="btn btn-sm btn-outline-success cc-fix-btn">
              <i class="fa fa-check fa-fw me-1"></i>{{fix_label}}
            </a>
            {{/has_fix}}
            <a href="{{simurl}}" class="btn btn-sm btn-outline-secondary cc-sim-btn">
              <i class="fa fa-play-circle fa-fw me-1"></i>{{#str}} checks_simulate_link, local_coursectrl {{/str}}
            </a>
          </div>
          {{#hascascade}}
          <p class="mb-0 text-info small mt-1">
            <i class="fa fa-chain fa-fw me-1"></i>{{cascade_count}} {{#str}} checks_cascade_suffix, local_coursectrl {{/str}}:
            {{#cascade}}<a href="{{url}}" target="_blank" rel="noopener" class="me-1">{{name}}</a>{{/cascade}}
          </p>
          {{/hascascade}}
          {{#hasjourneysteps}}
          <details class="mt-2">
            <summary class="small text-muted" style="cursor:pointer">
              <i class="fa fa-list-ol fa-fw me-1"></i>{{#str}} risk_journey_show_steps, local_coursectrl {{/str}}
            </summary>
            <ol class="mt-1 mb-0 ps-3 small">
              {{#journey_steps}}
              <li class="py-1">
                <span class="text-muted">{{steptime}}</span>
                — <a href="{{cmurl}}" target="_blank" rel="noopener">{{cmname}}</a>
                — <span class="{{#is_pass}}text-success{{/is_pass}}{{#is_fail}}text-danger{{/is_fail}}">{{outcome_label}}</span>
              </li>
              {{/journey_steps}}
            </ol>
          </details>
          {{/hasjourneysteps}}
        </div>
      </div>
      {{/rows}}
    </div>
    {{/hasrows}}
  </div>
  {{/risks}}
  {{/tab_risks}}

  {{! ═══ Simulation ══ }}
  {{#tab_simulation}}
  {{#simulation}}
  <div data-region="panel-simulation">{{{simulationhtml}}}</div>
  {{/simulation}}
  {{/tab_simulation}}

</div>

{{!
    @template local_coursectrl/dashboard

    Course Control Hub dashboard v2 with enriched activity data.

    Context variables required for this template:
    * courseid, coursefullname, courseshortname
    * coursestartdate, courseenddate, hasenddate, coursevisible
    * sectioncount, cmcount, textcount, hassections
    * warningcount, haswarnings
    * manageurl, textreviewurl, graphurl
    * sections - array with enriched cms
}}
<div class="local-coursectrl-dashboard" data-region="local_coursectrl-dashboard" data-courseid="{{courseid}}">

    {{! ---- Course header card ---- }}
    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <h2 class="h4 mb-0">{{coursefullname}}</h2>
                    <span class="text-muted small">{{courseshortname}}</span>
                </div>
                <div class="text-right small text-muted">
                    {{#userdate}}{{coursestartdate}}, {{#str}}strftimedaydate, core_langconfig{{/str}}{{/userdate}}
                    {{#hasenddate}} – {{#userdate}}{{courseenddate}}, {{#str}}strftimedaydate, core_langconfig{{/str}}{{/userdate}}{{/hasenddate}}
                    {{^coursevisible}} · <span class="badge badge-secondary">{{#str}}dashboard_hidden, local_coursectrl{{/str}}</span>{{/coursevisible}}
                </div>
            </div>
        </div>
    </div>

    {{! ---- Stat counters ---- }}
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-center h-100"><div class="card-body py-2">
                <div class="h4 mb-0">{{sectioncount}}</div>
                <div class="text-muted small">{{#str}}dashboard_sections, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100"><div class="card-body py-2">
                <div class="h4 mb-0">{{cmcount}}</div>
                <div class="text-muted small">{{#str}}dashboard_activities, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100"><div class="card-body py-2">
                <div class="h4 mb-0">{{textcount}}</div>
                <div class="text-muted small">{{#str}}dashboard_texts, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100 {{#haswarnings}}border-danger{{/haswarnings}}"><div class="card-body py-2">
                <div class="h4 mb-0 {{#haswarnings}}text-danger{{/haswarnings}}">{{warningcount}}</div>
                <div class="text-muted small">{{#str}}dashboard_warnings, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100 border-info"><div class="card-body py-2">
                <div class="h4 mb-0 text-info">{{upcoming7days}}</div>
                <div class="text-muted small">{{#str}}dashboard_upcoming7, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100 border-info"><div class="card-body py-2">
                <div class="h4 mb-0 text-info">{{upcoming28days}}</div>
                <div class="text-muted small">{{#str}}dashboard_upcoming28, local_coursectrl{{/str}}</div>
            </div></div>
        </div>
    </div>

    {{! ---- Collapsible calendar block ---- }}
    <div class="mb-3">
        <button type="button"
                class="btn btn-sm btn-outline-secondary mb-2"
                data-action="toggle-calendar"
                data-label-show="{{#str}}cal_show, local_coursectrl{{/str}}"
                data-label-hide="{{#str}}cal_hide, local_coursectrl{{/str}}"
                data-courseid="{{courseid}}">
            <i class="fa fa-calendar fa-fw"></i>
            <span data-cal-label>
                {{#showcalendar}}{{#str}}cal_hide, local_coursectrl{{/str}}{{/showcalendar}}
                {{^showcalendar}}{{#str}}cal_show, local_coursectrl{{/str}}{{/showcalendar}}
            </span>
        </button>
        <div class="local_coursectrl_calblock{{^showcalendar}} d-none{{/showcalendar}}"
             data-region="local_coursectrl-calwrapper">
            <div class="d-flex flex-nowrap overflow-auto gap-2 pb-1"
                 data-region="local_coursectrl-calrow" style="-webkit-overflow-scrolling:touch">
                {{#months}}
                <div class="flex-shrink-0{{#iscurrentmonth}} rounded{{/iscurrentmonth}}"
                     style="min-width:196px{{#iscurrentmonth}};background-color:rgb(215,228,214);border:1px solid rgb(198,218,198);border-radius:8px{{/iscurrentmonth}}"
                     data-monthkey="{{monthkey}}">
                    <div class="text-center small fw-semibold py-1">
                        <a href="{{timelineurl}}&tab=timeline" class="text-decoration-none">{{monthlabel}}</a>
                    </div>
                    {{#weeks}}
                    <div class="d-flex">
                        {{#days}}
                        <div class="text-center small flex-fill p-0
                             {{^inmonth}}text-muted{{/inmonth}}
                             {{#istoday}}border border-primary fw-bold{{/istoday}}
                             {{#isholiday}}bg-warning bg-opacity-25{{/isholiday}}"
                             style="min-width:1.55em;line-height:1.7em">
                            {{#inmonth}}{{#hasentries}}<a href="{{timelineurl}}&tab=timeline#day-{{daykey}}" target="_blank" rel="noopener" class="fw-bold">{{day}}</a>{{/hasentries}}{{^hasentries}}{{day}}{{/hasentries}}{{/inmonth}}
                            {{^inmonth}}&nbsp;{{/inmonth}}
                        </div>
                        {{/days}}
                    </div>
                    {{/weeks}}
                </div>
                {{/months}}
            </div>
        </div>
    </div>



    {{! ---- Inventory ---- }}
    {{#hassections}}
        {{#sections}}
            <div class="card mb-3">
                <div class="card-header py-2 d-flex align-items-center justify-content-between">
                    <span>
                        <strong>{{#str}}dashboard_section, local_coursectrl{{/str}} {{sectionnum}}</strong>
                        {{#hasname}}<span class="text-muted ml-2">{{name}}</span>{{/hasname}}
                    </span>
                    <span>
                        {{^visible}}<span class="badge badge-secondary mr-1">{{#str}}dashboard_hidden, local_coursectrl{{/str}}</span>{{/visible}}
                        <span class="badge badge-light">{{cmcount}}</span>
                    </span>
                </div>
                {{#hascms}}
                    <div class="list-group list-group-flush">
                        {{#cms}}
                            <div class="list-group-item py-2 px-3" id="cm-{{cmid}}">

                                {{! ---- Row 1: Name + badges + links ---- }}
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <div>
                                        {{#haswarnings}}{{#warnings}}<span title="{{message}}">{{icon}}</span> {{/warnings}}{{/haswarnings}}
                                        <code class="text-muted small mr-1">{{modname}}</code>
                                        <a href="{{activityurl}}" class="font-weight-bold">{{name}}</a>
                                        {{^visible}}<span class="badge badge-secondary ml-1">{{#str}}dashboard_hidden, local_coursectrl{{/str}}</span>{{/visible}}
                                    </div>
                                    <div>
                                        <a href="{{editurl}}" class="btn btn-outline-secondary btn-sm py-0 px-1"
                                           title="{{#str}}edit{{/str}}">{{#pix}}t/edit, core{{/pix}}</a>
                                    </div>
                                </div>

                                {{! ---- Row 2: Compact detail line ---- }}
                                <div class="small text-muted">

                                    {{! Dates ---- }}
                                    {{#hasdates}}
                                        {{#dates}}
                                            <span class="mr-2 {{#ispast}}text-decoration-line-through{{/ispast}}">
                                                <strong>{{field}}</strong> {{formatted}}
                                            </span>
                                        {{/dates}}
                                    {{/hasdates}}

                                    {{! Completion expected ---- }}
                                    {{#hascompletionexpected}}
                                        <span class="mr-2">⏰ {{completionexpected}}</span>
                                    {{/hascompletionexpected}}

                                    {{! Completion tracking ---- }}
                                    {{#hascompletion}}
                                        <span class="badge badge-info mr-1">{{completionlabel}}</span>
                                    {{/hascompletion}}

                                    {{! Date restrictions ---- }}
                                    {{#hasdaterestrictions}}
                                        {{#daterestrictions}}
                                            <span class="badge badge-warning mr-1">🔒 {{direction}} {{formatted}}</span>
                                        {{/daterestrictions}}
                                    {{/hasdaterestrictions}}

                                    {{! Prerequisites (what this depends on) ---- }}
                                    {{#hasprerequisites}}
                                        <span class="mr-1">{{#str}}dashboard_requires, local_coursectrl{{/str}}</span>
                                        {{#prerequisites}}
                                            <a href="{{anchor}}" class="badge badge-outline-primary mr-1" title="cmid {{cmid}}">⬆ {{name}}</a>
                                        {{/prerequisites}}
                                    {{/hasprerequisites}}

                                    {{! Dependents (what depends on this) ---- }}
                                    {{#hasdependents}}
                                        <span class="mr-1">{{#str}}dashboard_unlocks, local_coursectrl{{/str}}</span>
                                        {{#dependents}}
                                            <a href="{{anchor}}" class="badge badge-outline-secondary mr-1" title="cmid {{cmid}}">⬇ {{name}}</a>
                                        {{/dependents}}
                                    {{/hasdependents}}
                                </div>
                            </div>
                        {{/cms}}
                    </div>
                {{/hascms}}
            </div>
        {{/sections}}
    {{/hassections}}
    {{^hassections}}
        <div class="alert alert-info">{{#str}}dashboard_empty, local_coursectrl{{/str}}</div>
    {{/hassections}}
</div>

{{#js}}
require(['local_coursectrl/dashboard'], function(D) {
    D.init(document.querySelector('[data-region="local_coursectrl-dashboard"]'));
});
{{/js}}

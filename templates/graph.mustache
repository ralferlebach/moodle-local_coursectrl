{{!
    @template local_coursectrl/graph

    Dependency graph view. Gantt has moved to the Timeline page.

    Context variables required for this template:
    * courseid (int)
    * graphjson (string) — JSON for graphview.js
    * graphnodecount (int), graphedgecount (int)
    * groupoptions (array) [{id, name, selected}]
    * hasgroupoptions (bool)
    * graphurl (string)
    * activegroupid (int)
 * filterbygroup (bool)
    * hideindependents (bool)

    Example context (json):
    {"courseid":2,"graphnodecount":5,"graphedgecount":3,
     "graphjson":"{}","hasgroupoptions":false,"hideindependents":false}
}}

<div class="local_coursectrl_graph" data-region="local_coursectrl-graph"
     data-courseid="{{courseid}}">

  {{! ── Filter toolbar ─────────────────────────────────────────────────── }}
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    {{! Toggle independent activities }}
    <div class="form-check form-switch mb-0 ms-2">
      <input class="form-check-input" type="checkbox"
             id="hide-independents"
             data-action="toggle-independents"
             {{#hideindependents}}checked{{/hideindependents}}>
      <label class="form-check-label small" for="hide-independents">
        {{#str}} graph_hide_independents, local_coursectrl {{/str}}
      </label>
    </div>

    <div class="form-check form-switch mb-0 ms-2">
      <input class="form-check-input" type="checkbox"
             id="hide-hidden-cms"
             data-action="toggle-hidden">
      <label class="form-check-label small" for="hide-hidden-cms">
        {{#str}} graph_hide_hidden, local_coursectrl {{/str}}
      </label>
    </div>

    {{! Group-aware dependency filter: enable checkbox → group checkboxes appear }}
    {{#hasgroupoptions}}
    <form method="get" action="{{graphurl}}" id="coursectrl-depgroup-form"
          class="d-flex align-items-center gap-2 mb-0 ms-2">
      <input type="hidden" name="courseid" value="{{courseid}}">
      <input type="hidden" name="hideindependents"
             value="{{#hideindependents}}1{{/hideindependents}}{{^hideindependents}}0{{/hideindependents}}">
      {{! Step 1: enable switch }}
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox"
               id="coursectrl-depgroup-enable"
               name="filterbygroup" value="1"
               {{#filterbygroup}}checked{{/filterbygroup}}
               onchange="var b=document.getElementById('coursectrl-depgroup-btn');if(b)b.disabled=!this.checked;if(!this.checked)this.form.submit();">
        <label class="form-check-label small" for="coursectrl-depgroup-enable">
          {{#str}} graph_filterbygroup, local_coursectrl {{/str}}
        </label>
      </div>
      {{! Step 2: group checkboxes — disabled when switch is off }}
      <div id="coursectrl-depgroup-panel"
           class="position-relative d-inline-block">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                id="coursectrl-depgroup-btn"
                data-action="toggle-depgroupfilter"
                {{^filterbygroup}}disabled{{/filterbygroup}}>
          {{#str}} timeline_filter_group, local_coursectrl {{/str}}
        </button>
        <div data-region="local_coursectrl-depgroupfilter-menu"
             class="position-absolute bg-white border rounded shadow-sm p-3 mt-1 d-none"
             style="z-index:1050;min-width:200px;left:0">
          <ul style="list-style:none;margin:0;padding-left:0">
            {{#groupoptions}}
            <li class="coursectrl-simdrop-item">
              <input class="form-check-input" type="checkbox"
                     name="groupids[]" value="{{id}}"
                     id="depgrp-{{id}}"
                     {{#selected}}checked{{/selected}}>
              <label class="form-check-label" for="depgrp-{{id}}">{{name}}</label>
            </li>
            {{/groupoptions}}
          </ul>
          <div class="mt-2">
            <button type="submit" class="btn btn-sm btn-primary">
              {{#str}} apply, core {{/str}}
            </button>
          </div>
        </div>
      </div>
    </form>
    {{/hasgroupoptions}}

  </div>

  {{! Simulation overlay banner }}
  {{#hassimoverlay}}
  <div class="alert alert-info py-2 mb-2 small d-flex align-items-center gap-3">
    <i class="fa fa-info-circle"></i>
    <span>{{#str}} graph_sim_overlay_hint, local_coursectrl {{/str}}</span>
    <span class="d-flex align-items-center gap-3 ms-auto">
      <span class="d-inline-flex align-items-center gap-1">
        <span style="display:inline-block;width:1rem;height:1rem;background:#fef2f2;border:2px solid #dc3545;border-radius:3px"></span>
        {{#str}} sim_legend_blocked, local_coursectrl {{/str}}
      </span>
      <span class="d-inline-flex align-items-center gap-1">
        <span style="display:inline-block;width:1rem;height:1rem;background:#f0fdf4;border:2px solid #198754;border-radius:3px"></span>
        {{#str}} sim_legend_nextstep, local_coursectrl {{/str}}
      </span>
    </span>
  </div>
  {{/hassimoverlay}}

  {{! ── Graph canvas ────────────────────────────────────────────────────── }}
  <div class="overflow-auto border rounded p-2 bg-white"
       style="min-height:400px;-webkit-overflow-scrolling:touch">
    <div data-region="coursectrl-graph-canvas"
         data-graph="{{graphjson}}"
         data-hide-independents="{{hideindependents}}"
         style="width:100%;min-height:400px;overflow:hidden">
    </div>
  </div>

</div>

{{#js}}
require(['local_coursectrl/graphview'], function(G) {
    G.init(document.querySelector('[data-region="local_coursectrl-graph"]'));
});
(function() {
    var btn = document.getElementById('coursectrl-depgroup-btn');
    var menu = document.querySelector('[data-region="local_coursectrl-depgroupfilter-menu"]');
    if (!btn || !menu) { return; }
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        menu.classList.toggle('d-none');
    });
    document.addEventListener('click', function(e) {
        if (e.target !== btn && !menu.contains(e.target)) {
            menu.classList.add('d-none');
        }
    });
}());
{{/js}}

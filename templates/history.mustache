{{!
    @template local_coursectrl/history

    Batch history and rollback page.

    Context variables:
    * courseid, sesskey
    * batchrows     — list of batch records with rollback metadata
    * hasbatchrows, batchcount
    * hasrollbackresult, rollbacksuccess, rollbackerror
    * rollbackitems, hasrollbackitems, rollbackrestored, rollbackfailed
    * rollbackurl, dashboardurl, timelineurl
}}
<div class="local-coursectrl-history" data-region="local_coursectrl-history"
     data-courseid="{{courseid}}">

    <div class="mb-3">
        <a href="{{dashboardurl}}" class="btn btn-sm btn-outline-secondary">
            &laquo; {{#str}}nav_dashboard, local_coursectrl{{/str}}
        </a>
        <a href="{{timelineurl}}" class="btn btn-sm btn-outline-secondary ml-1">
            {{#str}}nav_timeline, local_coursectrl{{/str}}
        </a>
    </div>

    {{! ---- Rollback result notification ---- }}
    {{#hasrollbackresult}}
    {{#rollbacksuccess}}
    <div class="alert alert-success py-2 small">
        {{#str}}history_rollback_success, local_coursectrl, {"restored": "{{rollbackrestored}}"}{{/str}}
    </div>
    {{/rollbacksuccess}}
    {{^rollbacksuccess}}
    <div class="alert alert-danger py-2 small">
        {{#str}}history_rollback_error, local_coursectrl{{/str}}
        {{#rollbackerror}}: <code>{{rollbackerror}}</code>{{/rollbackerror}}
        {{#hasrollbackitems}}
        ({{rollbackfailed}} {{#str}}history_items_failed, local_coursectrl{{/str}})
        {{/hasrollbackitems}}
    </div>
    {{/rollbacksuccess}}
    {{#hasrollbackitems}}
    <div class="card mb-3">
        <div class="card-header py-2 small font-weight-bold">
            {{#str}}history_rollback_detail, local_coursectrl{{/str}}
        </div>
        <ul class="list-group list-group-flush">
            {{#rollbackitems}}
            <li class="list-group-item py-1 small {{#isrestored}}list-group-item-success{{/isrestored}}{{#iserror}}list-group-item-danger{{/iserror}}">
                {{#isrestored}}✅{{/isrestored}}{{#iserror}}❌{{/iserror}}
                <code>{{component}}</code> / id {{entityid}}
                {{#message}}<span class="text-muted ml-1">— {{message}}</span>{{/message}}
            </li>
            {{/rollbackitems}}
        </ul>
    </div>
    {{/hasrollbackitems}}
    {{/hasrollbackresult}}

    {{! ---- Batch list ---- }}
    {{#hasbatchrows}}
    <div class="card">
        <div class="card-header py-2 d-flex align-items-center justify-content-between">
            <strong class="small">{{#str}}history_batches, local_coursectrl{{/str}}: {{batchcount}}</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="font-size:12px;">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>{{#str}}history_col_action, local_coursectrl{{/str}}</th>
                        <th>{{#str}}history_col_date, local_coursectrl{{/str}}</th>
                        <th>{{#str}}history_col_items, local_coursectrl{{/str}}</th>
                        <th>{{#str}}history_col_status, local_coursectrl{{/str}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#batchrows}}
                    <tr>
                        <td class="text-muted">{{id}}</td>
                        <td><code>{{action}}</code></td>
                        <td>{{timecreated_formatted}}</td>
                        <td>{{itemcount}}</td>
                        <td>
                            {{#status_executed}}<span class="badge badge-success">{{status}}</span>{{/status_executed}}
                            {{#status_rolled_back}}<span class="badge badge-secondary">{{status}}</span>{{/status_rolled_back}}
                            {{#status_failed}}<span class="badge badge-danger">{{status}}</span>{{/status_failed}}
                            {{^status_executed}}{{^status_rolled_back}}{{^status_failed}}<span class="badge badge-light">{{status}}</span>{{/status_failed}}{{/status_rolled_back}}{{/status_executed}}
                        </td>
                        <td>
                            {{#can_rollback}}
                            <form method="post" action="{{rollbackurl}}"
                                  onsubmit="return confirm('{{#str}}history_rollback_confirm, local_coursectrl{{/str}}');">
                                <input type="hidden" name="courseid" value="{{courseid}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="batchid" value="{{id}}">
                                <button type="submit" class="btn btn-xs btn-outline-warning py-0 px-1">
                                    {{#str}}history_rollback_btn, local_coursectrl{{/str}}
                                </button>
                            </form>
                            {{/can_rollback}}
                            {{^can_rollback}}
                            {{#has_snapshots}}<span class="text-muted small">{{#str}}history_already_rolled_back, local_coursectrl{{/str}}</span>{{/has_snapshots}}
                            {{/can_rollback}}
                        </td>
                    </tr>
                    {{/batchrows}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasbatchrows}}
    {{^hasbatchrows}}
    <p class="text-muted">{{#str}}history_empty, local_coursectrl{{/str}}</p>
    {{/hasbatchrows}}

</div>

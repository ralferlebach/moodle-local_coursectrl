{{!
    @template local_coursectrl/history

    Logs & Historie: chronological list of batch actions with rollback.

    Context variables required for this template:
    * courseid (int)
    * rows (array) — batch rows, newest first
    * hasrows (bool)
    * rowcount (int)
    * maxbatches (int)
    * canrollback (bool)
    * dashboardurl (string)

    Example context (json):
    {"courseid":2,"hasrows":false,"rows":[],"rowcount":0,"maxbatches":100}
}}

<div class="local_coursectrl_history" data-region="local_coursectrl-history">

  {{#hasrows}}
  <p class="text-muted small mb-2">
    {{#str}} history_showing, local_coursectrl {{/str}} {{rowcount}} / {{maxbatches}}
  </p>
  <div class="list-group">
    {{#rows}}
    <div class="list-group-item list-group-item-action py-2 px-3
                {{#rolledback}}list-group-item-secondary{{/rolledback}}">
      <div class="d-flex align-items-center justify-content-between gap-2">
        <div class="flex-fill min-width-0">
          <span class="fw-semibold">{{actionlabel}}</span>
          <span class="badge {{#rolledback}}bg-secondary{{/rolledback}}{{^rolledback}}bg-light text-dark border{{/rolledback}} ms-1">
            {{status}}
          </span>
          <span class="text-muted small ms-2">
            <i class="fa fa-user fa-fw"></i>{{username}}
          </span>
          <span class="text-muted small ms-2" title="{{timeformatted}}">
            <i class="fa fa-clock fa-fw"></i>{{timeago}}
          </span>
          <span class="text-muted small ms-2">
            <i class="fa fa-list fa-fw"></i>{{itemcount}} {{#str}} history_items, local_coursectrl {{/str}}
          </span>
        </div>
        {{#canrollback}}
        <div class="flex-shrink-0">
          {{#canrollback}}
          <a href="{{rollbackurl}}" class="btn btn-sm btn-outline-danger"
             onclick="return confirm('{{#str}} rollback_confirm, local_coursectrl {{/str}}')">
            <i class="fa fa-undo fa-fw"></i>
            {{#str}} rollback_action, local_coursectrl {{/str}}
          </a>
          {{/canrollback}}
        </div>
        {{/canrollback}}
      </div>
    </div>
    {{/rows}}
  </div>
  {{/hasrows}}

  {{^hasrows}}
  <p class="text-muted">{{#str}} history_empty, local_coursectrl {{/str}}</p>
  {{/hasrows}}

</div>

{{!
    @template local_coursectrl/manage

    Bulk-action management page with action selector, payload config
    and course-module selection grouped by section.

    Context variables required for this template:
    * courseid - int
    * coursefullname - string
    * sesskey - string
    * previewurl - string
    * dashboardurl - string
    * actions - array of {value, label, selected}
    * sections - array of section objects with cms
    * hassections - bool
    * withdatescount - int
}}
<div class="local-coursectrl-manage" data-region="local_coursectrl-manage" data-courseid="{{courseid}}">


    <input type="hidden" name="action" value="shift_dates">
    <form id="coursectrl-manage-form" method="post" action="{{previewurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <input type="hidden" name="action" value="shift_dates">

        {{! ---- CM selection ---- }}
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="h5 mb-0">{{#str}}manage_select_activities, local_coursectrl{{/str}}</h3>
                <span>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-action="select-all-hasdates">
                        {{#str}}manage_select_all_dates, local_coursectrl{{/str}}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="deselect-all">
                        {{#str}}manage_deselect_all, local_coursectrl{{/str}}
                    </button>
                </span>
            </div>
            <div class="card-body">
                {{#hassections}}
                    <p class="text-muted small mb-3">
                        {{#str}}manage_dates_hint, local_coursectrl{{/str}}
                        <strong>{{withdatescount}}</strong>
                    </p>
                    {{#sections}}
                        <div class="mb-3 border-bottom pb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="form-check d-inline-flex align-items-center gap-2">
                                  <input type="checkbox" class="form-check-input"
                                         name="sectionids[]" value="{{id}}"
                                         id="coursectrl-section-{{id}}"
                                         data-sectionid="{{id}}"
                                         {{#nodates}}disabled{{/nodates}}
                                         {{#hasdates}}checked{{/hasdates}}>
                                  <label class="form-check-label fw-semibold mb-0"
                                         for="coursectrl-section-{{id}}">
                                    {{#str}}dashboard_section, local_coursectrl{{/str}} {{sectionnum}}
                                    {{#hasname}}<span class="text-muted ms-2">{{name}}</span>{{/hasname}}
                                  </label>
                                </div>
                                {{#hasdates}}
                                    <span class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-link py-0"
                                                data-action="select-section-dates" data-sectionid="{{id}}">
                                            {{#str}}manage_select_all_section, local_coursectrl{{/str}}
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link py-0 text-secondary"
                                                data-action="deselect-section" data-sectionid="{{id}}">
                                            {{#str}}manage_deselect_all_section, local_coursectrl{{/str}}
                                        </button>
                                    </span>
                                {{/hasdates}}
                            </div>
                            {{#hascms}}
                                {{#cms}}
                                    <div class="form-check ml-3 mb-1">
                                        <input type="checkbox" class="form-check-input"
                                               name="cmids[]" value="{{cmid}}"
                                               id="coursectrl-cm-{{cmid}}"
                                               data-sectionid="{{sectionid}}"
                                               {{#nodates}}disabled{{/nodates}}
                                               {{#hasdates}}checked{{/hasdates}}>
                                        <label class="form-check-label {{#nodates}}text-muted{{/nodates}}"
                                               for="coursectrl-cm-{{cmid}}">
                                            {{#pix}}monologo, mod_{{modname}}, {{modname}}{{/pix}}
                                            {{name}}
                                            {{#nodates}}
                                                <span class="badge bg-light text-dark border ms-1 small">
                                                    {{#str}}manage_nodates, local_coursectrl{{/str}}
                                                </span>
                                            {{/nodates}}
                                            {{^visible}}
                                                <span class="badge badge-secondary ml-1">
                                                    {{#str}}dashboard_hidden, local_coursectrl{{/str}}
                                                </span>
                                            {{/visible}}
                                        </label>
                                    </div>
                                {{/cms}}
                            {{/hascms}}
                            {{^hascms}}
                                <p class="text-muted small ml-3 mb-0">
                                    {{#str}}manage_no_activities, local_coursectrl{{/str}}
                                </p>
                            {{/hascms}}
                        </div>
                    {{/sections}}
                {{/hassections}}
                {{^hassections}}
                    <div class="alert alert-info">
                        {{#str}}dashboard_empty, local_coursectrl{{/str}}
                    </div>
                {{/hassections}}
            </div>
        </div>

        <div class="card mb-3">
          <div class="card-header py-2">
            <strong>{{#str}} manage_shift_title, local_coursectrl {{/str}}</strong>
          </div>
          <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
              <div class="d-flex gap-3" style="width:25rem">
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" id="coursectrl-delta-days" name="delta_days"
                         class="form-control" style="width:4rem" value="0">
                  <div class="input-group-append">
                    <span class="input-group-text">{{#str}}days{{/str}}</span>
                  </div>
                </div>
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" id="coursectrl-delta-hours" name="delta_hours"
                         class="form-control" style="width:3.5rem" value="0">
                  <div class="input-group-append">
                    <span class="input-group-text">{{#str}}hours{{/str}}</span>
                  </div>
                </div>
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" id="coursectrl-delta-minutes" name="delta_minutes"
                         class="form-control" style="width:3.5rem" value="0" min="0" max="59">
                  <div class="input-group-append">
                    <span class="input-group-text">{{#str}}minutes{{/str}}</span>
                  </div>
                </div>
              </div>
              <button type="submit" class="btn btn-sm btn-primary" id="coursectrl-preview-btn">
                {{#str}}manage_preview_btn, local_coursectrl{{/str}}
              </button>
            </div>
            <small class="form-text text-muted mt-1">
              {{#str}}manage_delta_help, local_coursectrl{{/str}}
            </small>
          </div>
        </div>
        </form>

  {{! Shift workflow modal }}
  <div id="coursectrl-manage-shift-dialog" class="modal fade" tabindex="-1" role="dialog"
       style="display:none" aria-hidden="true"
       data-label-config="{{#str}} manage_shift_title, local_coursectrl {{/str}}"
       data-label-preview="{{#str}} preview_title, local_coursectrl {{/str}}"
       data-label-textreview="{{#str}} tab_textreview, local_coursectrl {{/str}}"
       data-label-scantext="{{#str}} shift_scan_text, local_coursectrl {{/str}}">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title" data-ccwf-title>
            {{#str}} manage_shift_title, local_coursectrl {{/str}}
          </h6>
          <button type="button" class="close btn-close"
                  data-action="close-manage-dialog" aria-label="Close"></button>
        </div>
        {{! Step 1: placeholder — config lives on the page }}
        <div data-ccwf-step="1" class="d-none">
          <div class="modal-body py-2"></div>
        </div>
        {{! Step 2: preview + confirm }}
        <div data-ccwf-step="2">
          <div class="modal-body py-2" data-ccwf-preview-body></div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-action="close-manage-dialog">
              {{#str}} cancel, core {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-primary"
                    data-ccwf-action="execute">
              {{#str}} manage_preview_btn, local_coursectrl {{/str}}
            </button>
          </div>
        </div>
        {{! Step 3: text review }}
        <div data-ccwf-step="3" class="d-none">
          <div class="modal-body py-2">
            <div data-ccwf-shift-result></div>
            <div data-ccwf-hits-body></div>
          </div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-action="close-manage-dialog">
              {{#str}} shift_no_textchange, local_coursectrl {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-primary"
                    data-ccwf-action="apply-text">
              {{#str}} shift_ajax_review_apply, local_coursectrl {{/str}}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
{{#js}}
require(['local_coursectrl/manage'], function(mod) {
    mod.init('{{courseid}}');
});
{{/js}}

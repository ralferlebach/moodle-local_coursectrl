{{!
    @template local_coursectrl/navigation_bar

    Plugin-level tertiary navigation rendered as Moodle's core select_menu.
    Visually identical to the Participants page (user/index.php) selector.
    Non-clickable optgroup headers serve as section labels ("Einstellen", "Prüfen").

    Context variables required for this template:
    All variables expected by core/select_menu, plus:
    * currenturl (string) — URL of the currently active page (for JS navigation)

    Example context (json):
    {"currenturl":"https://example.com/local/coursectrl/timeline.php?courseid=2"}
}}
<div class="local_coursectrl_navbar mb-3" data-region="local_coursectrl-navbar">
  {{> core/select_menu}}
</div>

{{#js}}
require(['core/select_menu'], function() {
    var input = document.querySelector('[data-region="local_coursectrl-navbar"] input[type="hidden"]');
    if (!input) {
        return;
    }
    input.addEventListener('change', function() {
        if (input.value) {
            window.location.href = input.value;
        }
    });
});
{{/js}}

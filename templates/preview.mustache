{{!
    @template local_coursectrl/preview

    Bulk-action preview page showing a confirmation table of changes,
    skipped items and errors before execution.

    Context variables required for this template:
    * courseid - int
    * action - string
    * actionlabel - string
    * deltalabel - string
    * payloadjson - string
    * cmidsjson - string
    * sesskey - string
    * executeurl - string
    * manageurl - string
    * rows - array of change objects
    * hasrows - bool
    * skipped - array
    * hasskipped - bool
    * errors - array
    * haserrors - bool
    * summary_total, summary_changes, summary_skipped, summary_errors - int
    * canexecute - bool
}}
<div class="local-coursectrl-preview" data-region="local_coursectrl-preview">

    <div class="mb-3">
        <a href="{{manageurl}}" class="btn btn-sm btn-outline-secondary">
            &laquo; {{#str}}nav_bulk, local_coursectrl{{/str}}
        </a>
    </div>

    {{! ---- Summary card ---- }}
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}preview_summary, local_coursectrl{{/str}}</h3>
            <dl class="row mb-0 small">
                <dt class="col-sm-3">{{#str}}manage_action, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">{{actionlabel}}</dd>
                {{#deltalabel}}
                    <dt class="col-sm-3">{{#str}}manage_delta, local_coursectrl{{/str}}</dt>
                    <dd class="col-sm-9"><code>{{deltalabel}}</code></dd>
                {{/deltalabel}}
                <dt class="col-sm-3">{{#str}}preview_total, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">{{summary_total}}</dd>
                <dt class="col-sm-3">{{#str}}preview_with_changes, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-success">{{summary_changes}}</span>
                </dd>
                {{#summary_skipped}}
                    <dt class="col-sm-3">{{#str}}preview_skipped, local_coursectrl{{/str}}</dt>
                    <dd class="col-sm-9">
                        <span class="badge badge-warning">{{summary_skipped}}</span>
                    </dd>
                {{/summary_skipped}}
                {{#summary_errors}}
                    <dt class="col-sm-3">{{#str}}preview_errors, local_coursectrl{{/str}}</dt>
                    <dd class="col-sm-9">
                        <span class="badge badge-danger">{{summary_errors}}</span>
                    </dd>
                {{/summary_errors}}
            </dl>
        </div>
    </div>

    {{! ---- Changes table ---- }}
    {{#hasrows}}
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="h5 mb-0">{{#str}}preview_changes, local_coursectrl{{/str}}</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            <th>{{#str}}preview_col_activity, local_coursectrl{{/str}}</th>
                            <th>{{#str}}preview_col_field, local_coursectrl{{/str}}</th>
                            <th>{{#str}}preview_col_old, local_coursectrl{{/str}}</th>
                            <th>{{#str}}preview_col_new, local_coursectrl{{/str}}</th>
                            <th>{{#str}}preview_col_status, local_coursectrl{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            {{#fields}}
                                <tr class="{{^shifted}}{{#isunset}}table-light text-muted{{/isunset}}{{/shifted}}">
                                    {{#first}}
                                        <td rowspan="{{../fieldcount}}">
                                            <code class="small mr-1">{{../component}}</code>
                                            {{../name}}
                                        </td>
                                    {{/first}}
                                    <td><code>{{fieldname}}</code></td>
                                    <td>{{oldvalue}}</td>
                                    <td>{{#shifted}}<strong>{{newvalue}}</strong>{{/shifted}}{{^shifted}}{{newvalue}}{{/shifted}}</td>
                                    <td>
                                        {{#shifted}}
                                            <span class="badge badge-success">
                                                {{#str}}preview_status_changed, local_coursectrl{{/str}}
                                            </span>
                                        {{/shifted}}
                                        {{#isunset}}
                                            <span class="badge badge-light">
                                                {{#str}}preview_status_unset, local_coursectrl{{/str}}
                                            </span>
                                        {{/isunset}}
                                        {{^shifted}}{{^isunset}}
                                            <span class="badge badge-secondary">
                                                {{#str}}preview_status_unchanged, local_coursectrl{{/str}}
                                            </span>
                                        {{/isunset}}{{/shifted}}
                                    </td>
                                </tr>
                            {{/fields}}
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </div>
    {{/hasrows}}

    {{! ---- Skipped items ---- }}
    {{#hasskipped}}
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="h5 mb-0">{{#str}}preview_skipped, local_coursectrl{{/str}}</h3>
            </div>
            <ul class="list-group list-group-flush">
                {{#skipped}}
                    <li class="list-group-item d-flex justify-content-between">
                        <span>cmid {{cmid}}</span>
                        <span class="badge badge-warning">{{reason}}</span>
                    </li>
                {{/skipped}}
            </ul>
        </div>
    {{/hasskipped}}

    {{! ---- Errors ---- }}
    {{#haserrors}}
        <div class="alert alert-danger">
            <h4 class="alert-heading h6">{{#str}}preview_errors, local_coursectrl{{/str}}</h4>
            <ul class="mb-0">
                {{#errors}}
                    <li>cmid {{cmid}}: <code>{{code}}</code> {{message}}</li>
                {{/errors}}
            </ul>
        </div>
    {{/haserrors}}

    {{! ---- Confirm / Cancel ---- }}
    <div class="d-flex justify-content-between mt-3">
        <a href="{{manageurl}}" class="btn btn-secondary">
            {{#str}}cancel{{/str}}
        </a>
        {{#canexecute}}
            <form method="post" action="{{executeurl}}" id="coursectrl-execute-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <input type="hidden" name="action" value="{{action}}">
                <input type="hidden" name="payloadjson" value="{{payloadjson}}">
                <input type="hidden" name="cmidsjson" value="{{cmidsjson}}">
                <button type="submit" class="btn btn-danger" id="coursectrl-execute-btn">
                    {{#str}}preview_execute_btn, local_coursectrl{{/str}}
                </button>
            </form>
        {{/canexecute}}
        {{^canexecute}}
            <button type="button" class="btn btn-danger" disabled>
                {{#str}}preview_execute_btn, local_coursectrl{{/str}}
            </button>
        {{/canexecute}}
    </div>
</div>

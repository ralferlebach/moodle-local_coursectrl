{{!
    @template local_coursectrl/result

    Execution result page showing batch status and per-status counts.

    Context variables required for this template:
    * courseid - int
    * batchid - int
    * status - string
    * issuccess - bool
    * actionlabel - string
    * summary_total, summary_success, summary_skipped, summary_error - int
    * dashboardurl - string
    * manageurl - string
}}
<div class="local-coursectrl-result" data-region="local_coursectrl-result">

    {{#issuccess}}
        <div class="alert alert-success">
            <h4 class="alert-heading">{{#str}}result_success, local_coursectrl{{/str}}</h4>
            <p>{{#str}}result_batch_id, local_coursectrl{{/str}}: <strong>{{batchid}}</strong></p>
        </div>
    {{/issuccess}}
    {{^issuccess}}
        <div class="alert alert-danger">
            <h4 class="alert-heading">{{#str}}result_failed, local_coursectrl{{/str}}</h4>
            <p>{{#str}}result_batch_id, local_coursectrl{{/str}}: <strong>{{batchid}}</strong></p>
        </div>
    {{/issuccess}}

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}result_summary, local_coursectrl{{/str}}</h3>
            <dl class="row mb-0 small">
                <dt class="col-sm-3">{{#str}}manage_action, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">{{actionlabel}}</dd>
                <dt class="col-sm-3">{{#str}}preview_total, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">{{summary_total}}</dd>
                <dt class="col-sm-3">{{#str}}result_col_success, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-success">{{summary_success}}</span>
                </dd>
                {{#summary_skipped}}
                    <dt class="col-sm-3">{{#str}}preview_skipped, local_coursectrl{{/str}}</dt>
                    <dd class="col-sm-9">
                        <span class="badge badge-warning">{{summary_skipped}}</span>
                    </dd>
                {{/summary_skipped}}
                {{#summary_error}}
                    <dt class="col-sm-3">{{#str}}result_col_error, local_coursectrl{{/str}}</dt>
                    <dd class="col-sm-9">
                        <span class="badge badge-danger">{{summary_error}}</span>
                    </dd>
                {{/summary_error}}
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{dashboardurl}}" class="btn btn-primary">
            {{#str}}nav_dashboard, local_coursectrl{{/str}}
        </a>
        <a href="{{manageurl}}" class="btn btn-outline-secondary">
            {{#str}}result_new_action, local_coursectrl{{/str}}
        </a>
    </div>
</div>

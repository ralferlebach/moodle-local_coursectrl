{{!
    @template local_coursectrl/simulation

    Plausibilitäts- und Kollisionsprüfung (learner simulation).

    Context variables required for this template:
    * courseid (int), sesskey (string), selfurl (string)
    * simdate (string), simtime (string)
    * coursegroups (array) [{id, name, selected}]
    * hascoursegroups (bool)
    * coursegroupings (array) [{id, name, selected}]
    * hascoursegroupings (bool)
    * cmformrows (array), hascmformrows (bool)
    * hasresults (bool), resultrows, nextsteprows, blockedrows

    Example context (json):
    {"courseid":2,"sesskey":"x","simdate":"2026-06-01","simtime":"09:00",
     "hascoursegroups":false,"hascoursegroupings":false,"hascmformrows":false}
}}

<div class="local_coursectrl_simulation" data-region="local_coursectrl-simulation">

  <form method="get" action="{{selfurl}}" class="mb-4">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="run" value="1">

    <div class="row g-3 align-items-end">

      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_datetime, local_coursectrl {{/str}}
        </label>
        <div class="d-flex gap-1">
          <input type="date" name="simdate" class="form-control form-control-sm"
                 value="{{simdate}}" style="width:auto">
          <input type="time" name="simtime" class="form-control form-control-sm"
                 value="{{simtime}}" style="width:auto">
        </div>
      </div>

      {{#hascoursegroups}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_groups, local_coursectrl {{/str}}
        </label>
        <div class="dropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary dropdown-toggle"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  data-bs-auto-close="outside">
            {{#str}} sim_select_groups, local_coursectrl {{/str}}
          </button>
          <ul class="dropdown-menu p-2" style="min-width:200px">
            {{#coursegroups}}
            <li class="form-check ps-2">
              <input class="form-check-input" type="checkbox"
                     name="groupids[]" value="{{id}}"
                     id="simgroup-{{id}}"{{#selected}} checked{{/selected}}>
              <label class="form-check-label" for="simgroup-{{id}}">{{name}}</label>
            </li>
            {{/coursegroups}}
          </ul>
        </div>
      </div>
      {{/hascoursegroups}}

      {{#hascoursegroupings}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_groupings, local_coursectrl {{/str}}
        </label>
        <div class="dropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary dropdown-toggle"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  data-bs-auto-close="outside">
            {{#str}} sim_select_groupings, local_coursectrl {{/str}}
          </button>
          <ul class="dropdown-menu p-2" style="min-width:200px">
            {{#coursegroupings}}
            <li class="form-check ps-2">
              <input class="form-check-input" type="checkbox"
                     name="groupingids[]" value="{{id}}"
                     id="simgrouping-{{id}}"{{#selected}} checked{{/selected}}>
              <label class="form-check-label" for="simgrouping-{{id}}">{{name}}</label>
            </li>
            {{/coursegroupings}}
          </ul>
        </div>
      </div>
      {{/hascoursegroupings}}

      {{#hascmformrows}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_completions, local_coursectrl {{/str}}
        </label>
        <div class="dropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary dropdown-toggle"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  data-bs-auto-close="outside">
            {{#str}} sim_set_completions, local_coursectrl {{/str}}
          </button>
          <ul class="dropdown-menu p-2" style="min-width:260px;max-height:300px;overflow-y:auto">
            {{#cmformrows}}
            <li class="form-check ps-2 mb-1">
              <input class="form-check-input" type="checkbox"
                     name="completions[{{cmid}}]" value="1"
                     id="simcm-{{cmid}}"{{#iscomplete}} checked{{/iscomplete}}>
              <label class="form-check-label small" for="simcm-{{cmid}}">
                <i class="fa fa-{{modicon}} fa-fw text-muted"></i> {{cmname}}
              </label>
            </li>
            {{/cmformrows}}
          </ul>
        </div>
      </div>
      {{/hascmformrows}}

      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="fa fa-play fa-fw"></i>
          {{#str}} sim_run, local_coursectrl {{/str}}
        </button>
      </div>

    </div>
  </form>

  {{#hasresults}}
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card text-center border-success">
        <div class="card-body py-2">
          <div class="h4 mb-0 text-success">{{accessiblecount}}</div>
          <div class="small text-muted">{{#str}} sim_accessible, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center border-danger">
        <div class="card-body py-2">
          <div class="h4 mb-0 text-danger">{{blockedcount}}</div>
          <div class="small text-muted">{{#str}} sim_blocked, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body py-2">
          <div class="h4 mb-0">{{totalcmcount}}</div>
          <div class="small text-muted">{{#str}} sim_total, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
  </div>
  {{#hasnextsteps}}
  <h6>{{#str}} sim_nextsteps, local_coursectrl {{/str}} ({{nextstepcount}})</h6>
  <ul class="list-group mb-3">
    {{#nextsteprows}}
    <li class="list-group-item list-group-item-success py-1 px-2">
      <i class="fa fa-check fa-fw text-success"></i>
      <a href="{{cmurl}}" target="_blank" rel="noopener noreferrer">{{cmname}}</a>
    </li>
    {{/nextsteprows}}
  </ul>
  {{/hasnextsteps}}
  {{#hasblockedrows}}
  <h6>{{#str}} sim_blocked_list, local_coursectrl {{/str}}</h6>
  <ul class="list-group mb-3">
    {{#blockedrows}}
    <li class="list-group-item list-group-item-danger py-1 px-2">
      <i class="fa fa-lock fa-fw text-danger"></i>
      <a href="{{cmurl}}" target="_blank" rel="noopener noreferrer">{{cmname}}</a>
    </li>
    {{/blockedrows}}
  </ul>
  {{/hasblockedrows}}
  {{/hasresults}}

</div>

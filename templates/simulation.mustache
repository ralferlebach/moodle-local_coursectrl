{{!
    @template local_coursectrl/simulation

    Plausibilitäts- und Kollisionsprüfung (learner simulation).

    Context variables required for this template:
    * courseid (int), sesskey (string), selfurl (string)
    * simdate (string), simtime (string)
    * coursegroups (array) [{id, name, selected}]
    * hascoursegroups (bool)
    * coursegroupings (array) [{id, name, selected}]
    * hascoursegroupings (bool)
    * cmformrows (array), hascmformrows (bool)
    * hasresults (bool), resultrows, nextsteprows, blockedrows

    Example context (json):
    {"courseid":2,"sesskey":"x","simdate":"2026-06-01","simtime":"09:00",
     "hascoursegroups":false,"hascoursegroupings":false,"hascmformrows":false}
}}

<div class="local_coursectrl_simulation" data-region="local_coursectrl-simulation">

  <form method="get" action="{{selfurl}}" class="mb-4">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="run" value="1">

    <div class="row g-3 align-items-end">

      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_datetime, local_coursectrl {{/str}}
        </label>
        <div class="d-flex gap-1">
          <input type="date" name="simdate" class="form-control form-control-sm"
                 value="{{simdate}}" style="width:auto">
          <input type="time" name="simtime" class="form-control form-control-sm"
                 value="{{simtime}}" style="width:auto">
        </div>
      </div>

      {{#hascoursegroups}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_groups, local_coursectrl {{/str}}
        </label>
        <div class="position-relative d-inline-block" data-region="local_coursectrl-simdropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary"
                  data-action="toggle-simdropdown">
            {{#str}} sim_select_groups, local_coursectrl {{/str}}
          </button>
          <ul class="position-absolute bg-white border rounded shadow-sm p-2 mt-1 d-none"
              data-region="local_coursectrl-simdropdown-menu"
              style="z-index:1050;min-width:200px;list-style:none;margin:0">
            {{#coursegroups}}
            <li class="d-flex align-items-center gap-2 mb-1 px-2">
              <input class="form-check-input flex-shrink-0" type="checkbox"
                     name="groupids[]" value="{{id}}"
                     id="simgroup-{{id}}"{{#selected}} checked{{/selected}}
                     style="margin-left:0">
              <label class="form-check-label mb-0" for="simgroup-{{id}}" style="margin-left:10px">{{name}}</label>
            </li>
            {{/coursegroups}}
          </ul>
        </div>
      </div>
      {{/hascoursegroups}}

      {{#hascoursegroupings}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_groupings, local_coursectrl {{/str}}
        </label>
        <div class="position-relative d-inline-block" data-region="local_coursectrl-simdropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary"
                  data-action="toggle-simdropdown">
            {{#str}} sim_select_groupings, local_coursectrl {{/str}}
          </button>
          <ul class="position-absolute bg-white border rounded shadow-sm p-2 mt-1 d-none"
              data-region="local_coursectrl-simdropdown-menu"
              style="z-index:1050;min-width:200px;list-style:none;margin:0">
            {{#coursegroupings}}
            <li class="d-flex align-items-center gap-2 mb-1 px-2">
              <input class="form-check-input flex-shrink-0" type="checkbox"
                     name="groupingids[]" value="{{id}}"
                     id="simgrouping-{{id}}"{{#selected}} checked{{/selected}}
                     style="margin-left:0">
              <label class="form-check-label mb-0" for="simgrouping-{{id}}" style="margin-left:10px">{{name}}</label>
            </li>
            {{/coursegroupings}}
          </ul>
        </div>
      </div>
      {{/hascoursegroupings}}

      {{#hascmformrows}}
      <div class="col-auto">
        <label class="form-label mb-1 small fw-semibold text-nowrap">
          {{#str}} sim_completions, local_coursectrl {{/str}}
        </label>
        <div class="position-relative d-inline-block" data-region="local_coursectrl-simdropdown">
          <button type="button"
                  class="btn btn-sm btn-outline-secondary"
                  data-action="toggle-simdropdown">
            {{#str}} sim_set_completions, local_coursectrl {{/str}}
          </button>
          <ul class="position-absolute bg-white border rounded shadow-sm p-2 mt-1 d-none"
              data-region="local_coursectrl-simdropdown-menu"
              style="z-index:1050;min-width:260px;max-height:300px;overflow-y:auto;list-style:none;margin:0;padding-left:0">
            {{#cmformrows}}
            <li class="d-flex align-items-center gap-2 mb-1 px-2">
              <input class="form-check-input flex-shrink-0" type="checkbox"
                     name="completions[{{cmid}}]" value="1"
                     id="simcm-{{cmid}}"{{#iscomplete}} checked{{/iscomplete}}>
              <label class="form-check-label small mb-0" for="simcm-{{cmid}}">
                <i class="fa fa-{{modicon}} fa-fw text-muted"></i> {{cmname}}
              </label>
            </li>
            {{/cmformrows}}
          </ul>
        </div>
      </div>
      {{/hascmformrows}}

      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="fa fa-play fa-fw"></i>
          {{#str}} sim_run, local_coursectrl {{/str}}
        </button>
      </div>

    </div>
  </form>

  {{#hasresults}}
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card text-center border-success">
        <div class="card-body py-2">
          <div class="h4 mb-0 text-success">{{accessiblecount}}</div>
          <div class="small text-muted">{{#str}} sim_accessible, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center border-danger">
        <div class="card-body py-2">
          <div class="h4 mb-0 text-danger">{{blockedcount}}</div>
          <div class="small text-muted">{{#str}} sim_blocked, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body py-2">
          <div class="h4 mb-0">{{totalcmcount}}</div>
          <div class="small text-muted">{{#str}} sim_total, local_coursectrl {{/str}}</div>
        </div>
      </div>
    </div>
  </div>
  {{#hasnextsteps}}
  <h6>{{#str}} sim_nextsteps, local_coursectrl {{/str}} ({{nextstepcount}})</h6>
  <ul class="list-group mb-3">
    {{#nextsteprows}}
    <li class="list-group-item list-group-item-success py-1 px-2">
      <i class="fa fa-check fa-fw text-success"></i>
      <a href="{{cmurl}}" target="_blank" rel="noopener noreferrer">{{cmname}}</a>
    </li>
    {{/nextsteprows}}
  </ul>
  {{/hasnextsteps}}
  {{#hasblockedrows}}
  <h6>{{#str}} sim_blocked_list, local_coursectrl {{/str}}</h6>
  <ul class="list-group mb-3">
    {{#blockedrows}}
    <li class="list-group-item list-group-item-danger py-1 px-2">
      <i class="fa fa-lock fa-fw text-danger"></i>
      <a href="{{cmurl}}" target="_blank" rel="noopener noreferrer">{{cmname}}</a>
    </li>
    {{/blockedrows}}
  </ul>
  {{/hasblockedrows}}
  {{#hasresultrows}}
  <div class="card mb-3">
    <div class="card-header py-2">
      <strong>{{#str}} sim_result_all, local_coursectrl {{/str}}</strong>
    </div>
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead>
          <tr>
            <th>{{#str}} sim_col_activity, local_coursectrl {{/str}}</th>
            <th>{{#str}} sim_col_tracking, local_coursectrl {{/str}}</th>
            <th>{{#str}} sim_col_complete, local_coursectrl {{/str}}</th>
            <th>{{#str}} sim_col_accessible, local_coursectrl {{/str}}</th>
            <th>{{#str}} sim_col_reasons, local_coursectrl {{/str}}</th>
          </tr>
        </thead>
        <tbody>
          {{#resultrows}}
          <tr>
            <td class="{{#iscomplete}}bg-secondary-subtle{{/iscomplete}}">
              <a href="{{url}}" target="_blank" rel="noopener noreferrer">{{name}}</a>
              <code class="small text-muted">{{modname}}</code>
            </td>
            <td>
              {{#teacher_visible}}
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                  {{#str}} sim_tracking_active, local_coursectrl {{/str}}
                </span>
              {{/teacher_visible}}
              {{^teacher_visible}}
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                  {{#str}} sim_tracking_off, local_coursectrl {{/str}}
                </span>
              {{/teacher_visible}}
            </td>
            <td>
              {{#status_pass}}
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                  {{#str}} sim_status_pass, local_coursectrl {{/str}}
                </span>
              {{/status_pass}}
              {{#status_fail}}
                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">
                  {{#str}} sim_status_fail, local_coursectrl {{/str}}
                </span>
              {{/status_fail}}
              {{#status_unknown}}
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                  {{#str}} sim_status_unknown, local_coursectrl {{/str}}
                </span>
              {{/status_unknown}}
            </td>
            <td>
              {{#accessible}}
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                  {{#str}} yes, core {{/str}}
                </span>
              {{/accessible}}
              {{^accessible}}
                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">
                  {{#str}} no, core {{/str}}
                </span>
              {{/accessible}}
              {{#isnextstep}}<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">{{#str}} sim_badge_next, local_coursectrl {{/str}}</span>{{/isnextstep}}
              {{#isblocked}}<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1">{{#str}} sim_badge_blocked, local_coursectrl {{/str}}</span>{{/isblocked}}
            </td>
            <td>
              {{#hasreasons}}
                <ul class="mb-0 small ps-3">
                  {{#reasons}}
                  <li>{{{label}}}</li>
                  {{/reasons}}
                </ul>
              {{/hasreasons}}
              {{^hasreasons}}<span class="text-muted small">–</span>{{/hasreasons}}
            </td>
          </tr>
          {{/resultrows}}
        </tbody>
      </table>
    </div>
  </div>
  {{/hasresultrows}}
  {{/hasresults}}

</div>

{{#js}}
require(['local_coursectrl/simulation'], function(S) {
    S.init(document.querySelector('[data-region="local_coursectrl-simulation"]'));
});
{{/js}}

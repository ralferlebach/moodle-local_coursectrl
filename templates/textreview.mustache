{{!
    @template local_coursectrl/textreview

    Text-datetime review page listing detected date references in
    course free-text fields with confidence badges and selection for
    bulk application of a time shift.

    Context variables required for this template:
    * courseid - int
    * sesskey - string
    * dashboardurl - string
    * manageurl - string
    * textreviewurl - string
    * rows - array of hit objects
    * hasrows - bool
    * summary_total, summary_safe, summary_ambiguous, summary_informational - int
    * hassafe, hasambiguous, hasinformational - bool
    * selectablecount - int
}}
<div class="local-coursectrl-textreview" data-region="local_coursectrl-textreview" data-courseid="{{courseid}}">

    <div class="mb-3">
        <a href="{{dashboardurl}}" class="btn btn-sm btn-outline-secondary">
            &laquo; {{#str}}nav_dashboard, local_coursectrl{{/str}}
        </a>
        <a href="{{manageurl}}" class="btn btn-sm btn-outline-secondary ml-2">
            {{#str}}nav_bulk, local_coursectrl{{/str}}
        </a>
    </div>

    {{! ---- Summary card ---- }}
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}textreview_summary, local_coursectrl{{/str}}</h3>
            <dl class="row mb-0 small">
                <dt class="col-sm-3">{{#str}}preview_total, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">{{summary_total}}</dd>
                <dt class="col-sm-3">{{#str}}textreview_safe, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-success">{{summary_safe}}</span>
                </dd>
                <dt class="col-sm-3">{{#str}}textreview_ambiguous, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-warning">{{summary_ambiguous}}</span>
                </dd>
                <dt class="col-sm-3">{{#str}}textreview_informational, local_coursectrl{{/str}}</dt>
                <dd class="col-sm-9">
                    <span class="badge badge-secondary">{{summary_informational}}</span>
                </dd>
            </dl>
        </div>
    </div>

    {{#hasrows}}
        <form method="post" action="{{textreviewurl}}" id="coursectrl-textreview-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="action" value="apply">

            {{! ---- Delta input ---- }}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="h5 mb-0">{{#str}}textreview_apply_config, local_coursectrl{{/str}}</h3>
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label">
                            {{#str}}manage_delta, local_coursectrl{{/str}}
                        </label>
                        <div class="col-sm-9">
                            <div class="form-inline">
                                <div class="input-group mr-3 mb-2">
                                    <input type="number" name="delta_days"
                                           class="form-control" style="width:80px" value="0">
                                    <div class="input-group-append">
                                        <span class="input-group-text">{{#str}}days{{/str}}</span>
                                    </div>
                                </div>
                                <div class="input-group mb-2">
                                    <input type="number" name="delta_hours"
                                           class="form-control" style="width:80px" value="0">
                                    <div class="input-group-append">
                                        <span class="input-group-text">{{#str}}hours{{/str}}</span>
                                    </div>
                                </div>
                                <div class="input-group mb-2">
                                    <input type="number" name="delta_minutes"
                                           class="form-control" style="width:80px" value="0"
                                           min="0" max="59">
                                    <div class="input-group-append">
                                        <span class="input-group-text">{{#str}}minutes{{/str}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {{! ---- Hits table ---- }}
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="h5 mb-0">{{#str}}textreview_hits, local_coursectrl{{/str}}</h3>
                    <span>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-action="select-all-safe">
                            {{#str}}textreview_select_safe, local_coursectrl{{/str}}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-action="deselect-all-hits">
                            {{#str}}manage_deselect_all, local_coursectrl{{/str}}
                        </button>
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:40px"></th>
                                <th>{{#str}}textreview_col_location, local_coursectrl{{/str}}</th>
                                <th>{{#str}}textreview_col_match, local_coursectrl{{/str}}</th>
                                <th>{{#str}}textreview_col_normalized, local_coursectrl{{/str}}</th>
                                <th>{{#str}}textreview_col_confidence, local_coursectrl{{/str}}</th>
                                <th>{{#str}}textreview_col_context, local_coursectrl{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#rows}}
                                <tr class="{{#isinformational}}table-light text-muted{{/isinformational}}">
                                    <td>
                                        {{#selectable}}
                                            <input type="checkbox" name="hitids[]" value="{{id}}"
                                                   class="form-check-input"
                                                   data-confidence="{{confidence}}"
                                                   {{#issafe}}checked{{/issafe}}>
                                        {{/selectable}}
                                    </td>
                                    <td>
                                        {{#hascm}}
                                            {{#pix}}monologo, mod_{{modname}}, {{modname}}{{/pix}}
                                            <a href="{{cmurl}}" target="_blank" rel="noopener noreferrer">{{cmname}}</a>
                                        {{/hascm}}
                                        {{^hascm}}
                                            <code class="small">{{entitytype}}:{{entityid}}</code>
                                        {{/hascm}}
                                        <span class="text-muted small ml-1">{{fieldname}}</span>
                                    </td>
                                    <td><code>{{matchedtext}}</code></td>
                                    <td>
                                        {{#hasnormalized}}
                                            <code>{{normalizedvalue}}</code>
                                        {{/hasnormalized}}
                                        {{^hasnormalized}}
                                            <span class="text-muted">–</span>
                                        {{/hasnormalized}}
                                    </td>
                                    <td>
                                        {{#issafe}}
                                            <span class="badge badge-success">
                                                {{#str}}textreview_safe, local_coursectrl{{/str}}
                                            </span>
                                        {{/issafe}}
                                        {{#isambiguous}}
                                            <span class="badge badge-warning">
                                                {{#str}}textreview_ambiguous, local_coursectrl{{/str}}
                                            </span>
                                        {{/isambiguous}}
                                        {{#isinformational}}
                                            <span class="badge badge-secondary">
                                                {{#str}}textreview_informational, local_coursectrl{{/str}}
                                            </span>
                                        {{/isinformational}}
                                    </td>
                                    <td class="small text-muted">
                                        …{{contextbefore}}<strong>{{matchedtext}}</strong>{{contextafter}}…
                                    </td>
                                </tr>
                            {{/rows}}
                        </tbody>
                    </table>
                </div>
            </div>

            {{! ---- Submit ---- }}
            <div class="d-flex justify-content-between">
                <a href="{{dashboardurl}}" class="btn btn-secondary">
                    {{#str}}cancel{{/str}}
                </a>
                <button type="submit" class="btn btn-primary">
                    {{#str}}textreview_apply_btn, local_coursectrl{{/str}}
                </button>
            </div>
        </form>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">
            {{#str}}textreview_no_hits, local_coursectrl{{/str}}
        </div>
    {{/hasrows}}
</div>
{{#js}}
require(['local_coursectrl/textreview'], function(mod) {
    mod.init();
});
{{/js}}

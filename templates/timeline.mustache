    {{#js}}
    (function() {
      var PER_PAGE = 25;
      var currentPage = 0;
      var showAll = false;

      var table   = document.getElementById('coursectrl-textreview-table');
      var prevBtn = document.getElementById('cctr-prev');
      var nextBtn = document.getElementById('cctr-next');
      var label   = document.getElementById('cctr-page-label');
      var allBtn  = document.getElementById('cctr-showall');

      var allRows = table ? Array.from(table.querySelectorAll('tbody tr')) : [];
      var totalPages = Math.max(1, Math.ceil(allRows.length / PER_PAGE));

      function render() {
        allRows.forEach(function(tr, i) {
          if (showAll) {
            tr.style.display = '';
          } else {
            var inPage = (i >= currentPage * PER_PAGE && i < (currentPage + 1) * PER_PAGE);
            tr.style.display = inPage ? '' : 'none';
          }
        });
        if (label) {
          label.textContent = showAll
            ? (allRows.length + ' Einträge')
            : ((currentPage + 1) + ' / ' + totalPages);
        }
        if (prevBtn) { prevBtn.disabled = showAll || currentPage === 0; }
        if (nextBtn) { nextBtn.disabled = showAll || currentPage >= totalPages - 1; }
        if (allBtn) {
          allBtn.textContent = showAll ? 'Seitenweise' : 'Alle anzeigen';
        }
      }

      function jumpToToday() {
        var now = Math.floor(Date.now() / 1000);
        var best = -1;
        var bestDiff = Infinity;
        allRows.forEach(function(tr, i) {
          var ts = parseInt(tr.getAttribute('data-normalizedts') || '0', 10);
          if (ts > 0) {
            var diff = Math.abs(ts - now);
            if (diff < bestDiff) { bestDiff = diff; best = i; }
          }
        });
        if (best >= 0) {
          currentPage = Math.floor(best / PER_PAGE);
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          if (currentPage > 0) { currentPage--; render(); }
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          if (currentPage < totalPages - 1) { currentPage++; render(); }
        });
      }
      if (allBtn) {
        allBtn.addEventListener('click', function() {
          showAll = !showAll;
          render();
        });
      }

      // Context toggle: show short by default, (i) expands to full.
      // Clicking any other (i) or anywhere outside collapses all.
      function collapseAll(except) {
        table && table.querySelectorAll('.coursectrl-ctx-btn').forEach(function(b) {
          if (b === except) { return; }
          var long = b.nextElementSibling;
          var short = b.previousElementSibling;
          if (long) { long.classList.add('d-none'); }
          if (short) { short.classList.remove('d-none'); }
          var ic = b.querySelector('i');
          if (ic) { ic.className = 'fa fa-info-circle'; }
        });
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.coursectrl-ctx-btn')) {
          collapseAll(null);
        }
      });

      table && table.querySelectorAll('.coursectrl-ctx-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var long = btn.nextElementSibling;
          var short = btn.previousElementSibling;
          var expanded = long && !long.classList.contains('d-none');
          collapseAll(btn);
          if (expanded) {
            if (long) { long.classList.add('d-none'); }
            if (short) { short.classList.remove('d-none'); }
            btn.querySelector('i').className = 'fa fa-info-circle';
          } else {
            if (long) { long.classList.remove('d-none'); }
            if (short) { short.classList.add('d-none'); }
            btn.querySelector('i').className = 'fa fa-times-circle text-primary';
          }
        });
      });

      jumpToToday();
      render();

      // Selection buttons.
      var selAllSafe = document.querySelector('[data-action="select-all-safe"]');
      var deselAll   = document.querySelector('[data-action="deselect-all-hits"]');
      if (selAllSafe) {
        selAllSafe.addEventListener('click', function() {
          table && table.querySelectorAll('input[name="hitids[]"]').forEach(function(cb) {
            cb.checked = cb.getAttribute('data-confidence') === 'safe';
          });
        });
      }
      if (deselAll) {
        deselAll.addEventListener('click', function() {
          table && table.querySelectorAll('input[name="hitids[]"]').forEach(function(cb) {
            cb.checked = false;
          });
        });
      }
    })();
    {{/js}}


{{!
    @template local_coursectrl/timeline

    Timeline page with three tabs: Terminübersicht, Textprüfung, Grafische Übersicht.

    Context variables required for this template:
    * courseid (int)
    * sesskey (string)
    * tab_timeline, tab_textreview, tab_gantt (bool)
    * days (array) — [{dayformatted, daykey, ispast, slotcount, slots[]}]
    * slots (array) — [{timeformatted, timekey, ispast, entries[]}]
    * entries (array) — [{cmid, name, modname, field, activityurl, deletable}]
    * months (array) — calendar grid from calendar_grid_builder
    * showcalendar, showpast, onlywithdeps (bool)
    * componentoptions (array), hascomponentoptions (bool)
    * groupoptions (array), hasgroupoptions (bool)
    * shifturl, timelineurl, textreviewurl (string)
    * gantt_json (string)

    Example context (json):
    {"courseid":2,"tab_timeline":true,"days":[],"months":[],"showcalendar":true,
     "sesskey":"x","shifturl":"","timelineurl":""}
}}

<div class="local_coursectrl_timeline" data-region="local_coursectrl-timeline"
     data-courseid="{{courseid}}" data-shifturl="{{shifturl}}">

  {{! ── Tab navigation ──────────────────────────────────────────────────── }}
  <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
      <a class="nav-link{{#tab_timeline}} active{{/tab_timeline}}"
         href="{{timelineurl}}&amp;tab=timeline">
        {{#str}} tab_timeline, local_coursectrl {{/str}}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link{{#tab_textreview}} active{{/tab_textreview}}"
         href="{{timelineurl}}&amp;tab=textreview">
        {{#str}} tab_textreview, local_coursectrl {{/str}}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link{{#tab_gantt}} active{{/tab_gantt}}"
         href="{{timelineurl}}&amp;tab=gantt">
        {{#str}} tab_gantt, local_coursectrl {{/str}}
      </a>
    </li>
  </ul>

  {{! ── TAB: Terminübersicht ───────────────────────────────────────────── }}
  {{#tab_timeline}}

  {{! Single-row horizontally scrollable calendar }}
  <div class="card mb-3{{^showcalendar}} d-none{{/showcalendar}}"
       data-region="local_coursectrl-calwrapper">
    <div class="card-body p-2">
      <div class="d-flex flex-nowrap overflow-auto gap-2 pb-1"
           data-region="local_coursectrl-calrow"
           style="-webkit-overflow-scrolling:touch">
        {{#months}}
        <div class="flex-shrink-0 text-center{{#iscurrentmonth}} rounded{{/iscurrentmonth}}"
             style="min-width:196px{{#iscurrentmonth}};background-color:rgb(215,228,214);border:1px solid rgb(198,218,198);border-radius:8px{{/iscurrentmonth}}">
          <div class="small fw-semibold py-1">{{monthlabel}}</div>
          {{#weeks}}
          <div class="d-flex">
            {{#days}}
            <div class="text-center small flex-fill p-0
                 {{^inmonth}}text-muted{{/inmonth}}
                 {{#istoday}}border border-primary fw-bold{{/istoday}}
                 {{#isholiday}}bg-warning bg-opacity-25{{/isholiday}}"
                 style="min-width:1.55em;line-height:1.7em;{{#hasentries}}cursor:pointer{{/hasentries}}"
                 {{#hasentries}}data-action="jump-to-day" data-daykey="{{daykey}}"{{/hasentries}}
                 {{#hasholidays}}title="{{#holidaynames}}{{name}} {{/holidaynames}}"{{/hasholidays}}>
              {{#inmonth}}{{day}}{{/inmonth}}{{^inmonth}}&nbsp;{{/inmonth}}
            </div>
            {{/days}}
          </div>
          {{/weeks}}
        </div>
        {{/months}}
      </div>
    </div>
  </div>

  {{! Filter toolbar }}
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <button type="button" class="btn btn-sm btn-outline-secondary"
            data-action="toggle-calendar"
            data-label-show="{{#str}}cal_show, local_coursectrl{{/str}}"
            data-label-hide="{{#str}}cal_hide, local_coursectrl{{/str}}"
            data-courseid="{{courseid}}">
      <i class="fa fa-calendar fa-fw"></i>
      <span data-cal-label>
        {{#showcalendar}}{{#str}} cal_hide, local_coursectrl {{/str}}{{/showcalendar}}
        {{^showcalendar}}{{#str}} cal_show, local_coursectrl {{/str}}{{/showcalendar}}
      </span>
    </button>

    <form method="get" action="{{timelineurl}}" class="mb-0 d-inline">
      <input type="hidden" name="courseid" value="{{courseid}}">
      <input type="hidden" name="tab" value="timeline">
      <input type="hidden" name="groupid" value="{{activegroupid}}">
      <input type="hidden" name="showpast" value="0">
      <label class="mb-0">
        <input type="checkbox" name="showpast" value="1"
               class="me-1"{{#showpast}} checked{{/showpast}} onchange="this.form.submit()">
        {{#str}} toggle_past, local_coursectrl {{/str}}
      </label>
    </form>

    <label class="mb-0">
      <input type="checkbox" id="coursectrl-immediateapply" class="me-1"
             {{#immediateapply}}checked{{/immediateapply}}>
      {{#str}} shift_immediate_apply, local_coursectrl {{/str}}
    </label>

    {{#hasgroupoptions}}
    <form method="get" action="{{timelineurl}}" class="d-flex align-items-center gap-1 mb-0">
      <input type="hidden" name="courseid" value="{{courseid}}">
      <input type="hidden" name="tab" value="timeline">
      <label class="form-label mb-0 small text-nowrap">
        {{#str}} timeline_filter_group, local_coursectrl {{/str}}
      </label>
      <select name="groupid" class="form-select form-select-sm" style="width:auto"
              onchange="this.form.submit()">
        <option value="0"{{^activegroupid}} selected{{/activegroupid}}>
          {{#str}} timeline_filter_group_none, local_coursectrl {{/str}}
        </option>
        {{#groupoptions}}
        <option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>
        {{/groupoptions}}
      </select>
    </form>
    {{/hasgroupoptions}}

    {{#hascomponentoptions}}
    <div class="position-relative d-inline-block" data-region="local_coursectrl-compfilter">
      <button class="btn btn-sm btn-outline-secondary" type="button"
              data-action="toggle-compfilter">
        <i class="fa fa-filter fa-fw"></i>
        {{#str}} filter_activitytypes, local_coursectrl {{/str}}
      </button>
      <form method="get" action="{{timelineurl}}"
            data-region="local_coursectrl-compfilter-menu"
            class="position-absolute bg-white border rounded shadow-sm p-3 mt-1 d-none"
            style="z-index:1050;min-width:200px;left:0">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <input type="hidden" name="tab" value="timeline">
        <input type="hidden" name="groupid" value="{{activegroupid}}">
        {{#componentoptions}}
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="components[]"
                 value="{{value}}" id="comp-{{value}}"{{#selected}} checked{{/selected}}>
          <label class="form-check-label small" for="comp-{{value}}">{{label}}</label>
        </div>
        {{/componentoptions}}
        <div class="mt-2">
          <button type="submit" class="btn btn-sm btn-primary">
            {{#str}} apply, core {{/str}}
          </button>
        </div>
      </form>
    </div>
    {{/hascomponentoptions}}
  </div>

  {{! Date rows }}
  {{#hasdays}}
  <div data-region="local_coursectrl-days">
    {{#days}}
    <div class="card mb-2{{#ispast}} opacity-75{{/ispast}}"
         id="day-{{daykey}}" data-daykey="{{daykey}}">
      <div class="card-header py-1 d-flex align-items-center gap-2">
        <strong class="{{#ispast}}text-muted{{/ispast}}">{{dayformatted}}</strong>
        <span class="badge bg-light text-dark border small">{{slotcount}}</span>
      </div>
      {{#slots}}
      <div class="card-body py-1 px-2">
        <div class="d-flex align-items-center justify-content-between mb-1">
          <span class="small text-muted">{{timeformatted}}</span>
          <span class="d-flex gap-1">
            {{! Shift this slot (single date/time) }}
            <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1"
                    data-action="shift-slot" data-timestamp="{{timekey}}"
                    title="{{#str}} timeline_action_shift_slot, local_coursectrl {{/str}}">
              <i class="fa fa-calendar-day fa-sm"></i>
              <i class="fa fa-arrow-right fa-sm"></i>
            </button>
            {{! Shift following activities (all after this date) }}
            <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1"
                    data-action="shift-following" data-timestamp="{{timekey}}"
                    title="{{#str}} shift_following, local_coursectrl {{/str}}">
              <i class="fa fa-calendar-days fa-sm"></i>
              <i class="fa fa-angles-double-right fa-sm"></i>
            </button>
          </span>
        </div>
        <ul class="list-group list-group-flush">
          {{#entries}}
          <li class="list-group-item d-flex align-items-center justify-content-between py-1 px-0">
            <span class="text-truncate me-2">
              <code class="small text-muted me-1">{{modname}}</code>
              <a href="{{activityurl}}" target="_blank" rel="noopener noreferrer">{{name}}</a>
              <span class="badge bg-light text-dark border ms-1 small">{{field}}</span>
            </span>
            <span class="d-flex gap-1 flex-shrink-0">
              {{! Shift this single entry }}
              <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1"
                      data-action="shift-entry" data-cmid="{{cmid}}"
                      data-field="{{field}}"
                      title="{{#str}} shift_single, local_coursectrl {{/str}}">
                <i class="fa fa-calendar-day fa-sm"></i>
                <i class="fa fa-arrow-right fa-sm"></i>
              </button>
              {{#deletable}}
              <button type="button" class="btn btn-sm btn-outline-danger p-1 lh-1"
                      data-action="delete-entry" data-cmid="{{cmid}}"
                      data-field="{{field}}" data-name="{{name}}"
                      title="{{#str}} timeline_action_delete_entry, local_coursectrl {{/str}}">
                <i class="fa fa-times fa-sm"></i>
              </button>
              {{/deletable}}
            </span>
          </li>
          {{/entries}}
        </ul>
      </div>
      {{/slots}}
    </div>
    {{/days}}
  </div>
  {{/hasdays}}
  {{^hasdays}}
  <p class="text-muted mt-3">{{#str}} no_dates_found, local_coursectrl {{/str}}</p>
  {{/hasdays}}

  {{! ── Shift dialog (existing mechanism) ─────────────────────────────── }}
  <div id="coursectrl-shift-dialog" class="modal fade" tabindex="-1" role="dialog"
       style="display:none" aria-hidden="true">
    <div class="modal-dialog" id="coursectrl-shift-dialog-inner" role="document">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title" id="coursectrl-shift-dialog-title"
              data-label-single="{{#str}} timeline_shift_heading, local_coursectrl {{/str}}"
              data-label-following="{{#str}} timeline_shift_following_heading, local_coursectrl {{/str}}"
              data-label-review="{{#str}} tab_textreview, local_coursectrl {{/str}}">
            {{#str}} timeline_shift_heading, local_coursectrl {{/str}}
          </h6>
          <button type="button" class="close btn-close"
                  data-action="close-dialog" aria-label="Close"></button>
        </div>

        {{! ── Step 1: shift configuration ──────────────────────────────── }}
        <div id="coursectrl-shift-step1">
          <form method="post" action="{{shifturl}}" id="coursectrl-shift-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="cmids" id="coursectrl-shift-cmids" value="">
            <input type="hidden" name="action_type" value="shift_dates">
            <input type="hidden" name="mode" id="coursectrl-shift-mode" value="slot">
            <input type="hidden" name="followdeps"
                   id="coursectrl-shift-followdeps" value="0">
            <input type="hidden" name="scan_text"
                   id="coursectrl-shift-scantext" value="0">
            <input type="hidden" name="shift_fields"
                   id="coursectrl-shift-fields" value="">
            <div class="modal-body py-2">
              <p id="coursectrl-shift-target" class="small text-muted mb-2"></p>
              <div class="form-group mb-2">
                <label class="small">
                  {{#str}} timeline_shift_days, local_coursectrl {{/str}}
                </label>
                <input type="number" name="delta_days" id="coursectrl-shift-delta-days"
                       class="form-control form-control-sm" style="width:80px" value="0">
              </div>
              <div class="form-group mb-2">
                <label class="small">
                  {{#str}} timeline_shift_hours, local_coursectrl {{/str}}
                </label>
                <input type="number" name="delta_hours" id="coursectrl-shift-delta-hours"
                       class="form-control form-control-sm" style="width:80px" value="0">
              </div>
              <div class="form-check">
                <input type="checkbox" id="coursectrl-shift-followdeps-cb"
                       class="form-check-input">
                <label class="form-check-label small" for="coursectrl-shift-followdeps-cb">
                  {{#str}} shift_dependants, local_coursectrl {{/str}}
                </label>
              </div>
              <div class="form-check mt-1">
                <input type="checkbox" id="coursectrl-shift-scantext-cb"
                       class="form-check-input" checked>
                <label class="form-check-label small" for="coursectrl-shift-scantext-cb">
                  {{#str}} shift_scan_text, local_coursectrl {{/str}}
                </label>
              </div>
            </div>
            <div class="modal-footer py-2 d-flex justify-content-between">
              <button type="button" class="btn btn-sm btn-secondary"
                      data-action="close-dialog">
                {{#str}} cancel, core {{/str}}
              </button>
              <button type="submit" class="btn btn-sm btn-primary">
                {{#str}} timeline_shift_apply, local_coursectrl {{/str}}
              </button>
            </div>
          </form>
        </div>

        {{! ── Step 2: loading → review panel (AJAX-populated) ─────────── }}
        <div id="coursectrl-shift-step2" class="d-none">
          <div id="coursectrl-shift-loading" class="modal-body py-4 text-center">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
              <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 small text-muted mb-0"
               id="coursectrl-shift-statusmsg"></p>
          </div>
          <div id="coursectrl-shift-review"
               class="d-none modal-body py-2"
               style="max-height:60vh;overflow-y:auto"></div>
          <div id="coursectrl-shift-step2-footer"
               class="modal-footer py-2 d-flex justify-content-between d-none">
            <button type="button" id="coursectrl-shift-skip-text"
                    class="btn btn-sm btn-secondary">
              {{#str}} shift_ajax_skip, local_coursectrl {{/str}}
            </button>
            <button type="button" id="coursectrl-shift-apply-text"
                    class="btn btn-sm btn-primary d-none">
              {{#str}} shift_ajax_review_apply, local_coursectrl {{/str}}
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div id="coursectrl-delete-dialog" class="modal fade" tabindex="-1" role="dialog"
       style="display:none" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title">
            {{#str}} timeline_delete_heading, local_coursectrl {{/str}}
          </h6>
          <button type="button" class="close btn-close"
                  data-action="close-dialog" aria-label="Close"></button>
        </div>
        <form method="post" action="{{shifturl}}">
          <input type="hidden" name="sesskey" value="{{sesskey}}">
          <input type="hidden" name="courseid" value="{{courseid}}">
          <input type="hidden" name="cmids" id="coursectrl-delete-cmids" value="">
          <input type="hidden" name="action_type" value="unset_dates">
          <input type="hidden" name="fields" id="coursectrl-delete-fields" value="">
          <div class="modal-body py-2">
            <p id="coursectrl-delete-target" class="small mb-0"></p>
          </div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-action="close-dialog">
              {{#str}} cancel, core {{/str}}
            </button>
            <button type="submit" class="btn btn-sm btn-danger">
              {{#str}} delete, core {{/str}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  {{/tab_timeline}}

  {{! ── TAB: Textprüfung ───────────────────────────────────────────────── }}
  {{#tab_textreview}}
  <div id="tab-textreview" data-region="local_coursectrl-textreview-panel"
       data-courseid="{{courseid}}" data-textreviewurl="{{textreviewurl}}">

    {{! Workflow-Hinweis: Textprüfung ist Teil des Terminverschiebe-Workflows }}
    {{#textreview_from_shift}}
    <div class="alert alert-success d-flex align-items-start gap-2 mb-3">
      <i class="fa fa-check-circle mt-1 flex-shrink-0"></i>
      <div>
        <strong>{{#str}} shift_done, local_coursectrl {{/str}}</strong>
        <p class="mb-0 small">{{#str}} textreview_workflow_hint, local_coursectrl {{/str}}</p>
      </div>
    </div>
    {{/textreview_from_shift}}
    {{^textreview_from_shift}}
    <div class="alert alert-info d-flex align-items-start gap-2 mb-3">
      <i class="fa fa-info-circle mt-1 flex-shrink-0"></i>
      <div>
        <strong>{{#str}} textreview_workflow_hint_title, local_coursectrl {{/str}}</strong>
        <p class="mb-0 small">{{#str}} textreview_workflow_hint, local_coursectrl {{/str}}</p>
      </div>
    </div>
    {{/textreview_from_shift}}

    {{#textreview_hasrows}}
    {{! Schritt 1: Verschiebungskonfiguration }}
    <div class="card mb-3">
      <div class="card-header py-2">
        <strong>{{#str}} textreview_apply_config, local_coursectrl {{/str}}</strong>
      </div>
      <div class="card-body py-2">
        <form method="post" action="{{textreviewurl}}"
              id="coursectrl-textreview-inline-form">
          <input type="hidden" name="sesskey" value="{{sesskey}}">
          <input type="hidden" name="courseid" value="{{courseid}}">
          <input type="hidden" name="action" value="apply">
          <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
            <div>
              <label class="form-label small mb-1">
                {{#str}} manage_delta, local_coursectrl {{/str}}
              </label>
              <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="width:120px">
                  <input type="number" name="delta_days" class="form-control"
                         style="width:60px" value="{{textreview_delta_days}}">
                  <span class="input-group-text">{{#str}} days {{/str}}</span>
                </div>
                <div class="input-group input-group-sm" style="width:130px">
                  <input type="number" name="delta_hours" class="form-control"
                         style="width:60px" value="{{textreview_delta_hours}}">
                  <span class="input-group-text">{{#str}} hours {{/str}}</span>
                </div>
              </div>
            </div>
          </div>

          {{! Schritt 2: Kollisionsprüfungs-Zusammenfassung }}
          {{#textreview_hascollisions}}
          <div class="alert alert-warning mb-3">
            <i class="fa fa-exclamation-triangle"></i>
            <strong>{{#str}} textreview_collision_warning, local_coursectrl {{/str}}</strong>
            <ul class="mb-0 mt-1 small">
              {{#textreview_collisions}}
              <li>{{message}}</li>
              {{/textreview_collisions}}
            </ul>
          </div>
          {{/textreview_hascollisions}}

          {{! Schritt 3+4: Texttreffer-Tabelle zur Review }}
          <div class="card mb-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <strong>{{#str}} textreview_hits, local_coursectrl {{/str}}</strong>
              <span>
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-action="select-all-safe">
                  {{#str}} textreview_select_safe, local_coursectrl {{/str}}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-action="deselect-all-hits">
                  {{#str}} manage_deselect_all, local_coursectrl {{/str}}
                </button>
              </span>
            </div>
            <div class="table-responsive">
              <table class="table table-striped table-sm mb-0">
                <thead>
                  <tr>
                    <th style="width:40px"></th>
                    <th>{{#str}} textreview_col_location, local_coursectrl {{/str}}</th>
                    <th>{{#str}} textreview_col_match, local_coursectrl {{/str}}</th>
                    <th>{{#str}} textreview_col_normalized, local_coursectrl {{/str}}</th>
                    <th>{{#str}} textreview_col_confidence, local_coursectrl {{/str}}</th>
                    <th>{{#str}} textreview_col_context, local_coursectrl {{/str}}</th>
                  </tr>
                </thead>
                <tbody>
                  {{#textreview_rows}}
                  <tr class="{{#isinformational}}table-light text-muted{{/isinformational}}">
                    <td>
                      {{#selectable}}
                      <input type="checkbox" name="hitids[]" value="{{id}}"
                             class="form-check-input" data-confidence="{{confidence}}"
                             {{#issafe}}checked{{/issafe}}>
                      {{/selectable}}
                    </td>
                    <td>
                      <code class="small">{{entitytype}}:{{entityid}}</code>
                      <span class="text-muted small ml-1">{{fieldname}}</span>
                    </td>
                    <td><code>{{matchedtext}}</code></td>
                    <td>
                      {{#hasnormalized}}<code>{{normalizedvalue}}</code>{{/hasnormalized}}
                      {{^hasnormalized}}<span class="text-muted">–</span>{{/hasnormalized}}
                    </td>
                    <td>
                      {{#issafe}}<span class="badge badge-success">{{#str}} textreview_safe, local_coursectrl {{/str}}</span>{{/issafe}}
                      {{#isambiguous}}<span class="badge badge-warning">{{#str}} textreview_ambiguous, local_coursectrl {{/str}}</span>{{/isambiguous}}
                      {{#isinformational}}<span class="badge badge-secondary">{{#str}} textreview_informational, local_coursectrl {{/str}}</span>{{/isinformational}}
                    </td>
                    <td class="small text-muted">
                      …{{contextbefore}}<strong>{{matchedtext}}</strong>{{contextafter}}…
                    </td>
                  </tr>
                  {{/textreview_rows}}
                </tbody>
              </table>
            </div>
          </div>

          {{! Schritt 5+6: Bestätigung und Ausführung }}
          <div class="d-flex justify-content-between align-items-center">
            <a href="{{timelineurl}}&amp;tab=timeline" class="btn btn-sm btn-secondary">
              &larr; {{#str}} tab_timeline, local_coursectrl {{/str}}
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-check fa-fw"></i>
              {{#str}} textreview_apply_btn, local_coursectrl {{/str}}
            </button>
          </div>
        </form>
      </div>
    </div>
    {{/textreview_hasrows}}

    {{^textreview_hasrows}}
    <div class="alert alert-info">
      {{#str}} textreview_no_hits, local_coursectrl {{/str}}
    </div>
    <p>
      <a href="{{timelineurl}}&amp;tab=timeline" class="btn btn-sm btn-secondary">
        &larr; {{#str}} tab_timeline, local_coursectrl {{/str}}
      </a>
    </p>
    {{/textreview_hasrows}}
  </div>
  {{/tab_textreview}}

  {{! ── TAB: Grafische Übersicht (Gantt) ───────────────────────────────── }}
  {{#tab_gantt}}
  <div id="tab-gantt">
    {{#gantt_hasdata}}
    <div class="overflow-auto border rounded p-2"
         data-region="local_coursectrl-gantt"
         data-gantt="{{gantt_json}}"
         style="-webkit-overflow-scrolling:touch;min-height:120px">
    </div>
    {{/gantt_hasdata}}
    {{^gantt_hasdata}}
    <p class="text-muted mt-3">{{#str}} no_dates_found, local_coursectrl {{/str}}</p>
    {{/gantt_hasdata}}
  </div>
  {{/tab_gantt}}

</div>

{{#js}}
require(['local_coursectrl/timeline'], function(T) {
    T.init(document.querySelector('[data-region="local_coursectrl-timeline"]'));
});
{{/js}}
